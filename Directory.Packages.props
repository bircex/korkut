<Project>

  <!-- KDM-005 — Central Package Management. All package versions live here; csproj
       files reference packages without versions. Keeps versions consistent across
       every project and makes SCA/dependency review a single surface. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test stack -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- Architecture boundary tests -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- ASP.NET Core integration testing -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <!-- Worker host -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <!-- Governance (Phase 10): retry/backoff + circuit-breaker around provider rate limits -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <!-- Gateway (Phase 8): YARP reverse proxy -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- API foundation (KDM-006) -->
    <PackageVersion Include="Asp.Versioning.Http" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Transitive-pin Microsoft.OpenApi to a patched version (NU1903: 2.0.0 has a
         known high-severity advisory GHSA-v5pm-xwqc-g5wc). -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <!-- Observability (KDM-007) -->
    <PackageVersion Include="OpenTelemetry" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.17.0" />
    <!-- Data foundation (KDM-011) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Knowledge/RAG vector store (Phase 5): pgvector column type + EF mapping. -->
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <!-- Google OIDC (KDM-016) -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.21.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.21.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.21.0" />
    <!-- Object storage (KDM-025) -->
    <PackageVersion Include="Minio" Version="7.0.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Testcontainers.Minio" Version="4.13.0" />
    <!-- Legal-source tools (Agent/Tools/Law): PDF journal/decision text extraction -->
    <PackageVersion Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

</Project>
