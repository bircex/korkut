# Build context is the repository root; the .NET Dockerfiles live under docker/ and
# only COPY global.json + Directory.*.props + .editorconfig + src/ + templates/ (the
# legal template catalog ships in the api/agent/worker images), plus ui/ for the SPA the
# gateway serves. Everything else is excluded to keep the context minimal and free of
# artifacts/secrets.
.git
.github
docs
config
assets
tests
data
backups

# The marketing site is a separate static deploy, never part of an image.
website

# The SPA is built inside the image from a clean `npm ci`.
ui/node_modules
ui/dist
ui/e2e
ui/test-results
ui/playwright-report

# .NET + Python build artifacts.
**/bin/
**/obj/
**/TestResults/
**/*.user
**/.vs/
**/__pycache__
**/*.py[cod]
.venv
venv
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
.coverage.*
coverage.xml

# Secrets and runtime data never go into the image.
.env
.env.*
!.env.example
*.db

*.md
