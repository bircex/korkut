---
import { INSTALL_DOCS_URL, GITHUB_URL } from "../consts";

// Her işletim sistemi için adım adım kurulum. Komutlar docs/INSTALL.md ile birebir.
const clone = "git clone https://github.com/recepkizilarslan/korkut.git\ncd korkut";

const tabs = [
  {
    id: "macos",
    label: "macOS",
    checked: true,
    prereq: "Gereksinim: Python 3.12+ ve Node 20+ (Homebrew ile: brew install python node).",
    steps: [
      { t: "Depoyu klonlayın", d: "Terminal'i açın ve projeyi indirin.", code: clone },
      {
        t: "Kurulum betiğini çalıştırın",
        d: ".venv oluşturur, backend'i kurar, arayüzü derler ve otomatik bir .env yazar. Tekrar çalıştırmak güvenlidir.",
        code: "./scripts/install.sh",
      },
      {
        t: "Bir model tanımlayın",
        d: ".env dosyasına GROQ_API_KEY ya da ANTHROPIC_API_KEY ekleyin; veya girişten sonra Ayarlar → Model'den yerel bir uç noktaya bağlanın (örn. LM Studio: http://localhost:1234/v1).",
        code: null,
      },
      {
        t: "İlk kullanıcıyı oluşturun",
        d: "Sizden bir parola istenecek.",
        code: 'cd backend && ../.venv/bin/python -m korkut.api.adduser avukat --name "Av. Ad Soyad"',
      },
      {
        t: "Sunucuyu başlatın",
        d: "http://localhost:8080 adresini açın. İlk girişte TOTP 2FA kurulur — QR'ı okutun, kurtarma kodlarını saklayın.",
        code: "cd backend && ../.venv/bin/python -m korkut.api",
      },
    ],
  },
  {
    id: "linux",
    label: "Linux",
    prereq: "Gereksinim: Python 3.12+ ve Node 20+ (paket yöneticinizden kurun).",
    steps: [
      { t: "Depoyu klonlayın", d: "Terminal'i açın ve projeyi indirin.", code: clone },
      {
        t: "Kurulum betiğini çalıştırın",
        d: ".venv oluşturur, backend'i kurar, arayüzü derler ve otomatik bir .env yazar. Tekrar çalıştırmak güvenlidir.",
        code: "./scripts/install.sh",
      },
      {
        t: "Bir model tanımlayın",
        d: ".env dosyasına GROQ_API_KEY ya da ANTHROPIC_API_KEY ekleyin; veya girişten sonra Ayarlar → Model'den yerel bir uç noktaya bağlanın (örn. Ollama / LM Studio).",
        code: null,
      },
      {
        t: "İlk kullanıcıyı oluşturun",
        d: "Sizden bir parola istenecek.",
        code: 'cd backend && ../.venv/bin/python -m korkut.api.adduser avukat --name "Av. Ad Soyad"',
      },
      {
        t: "Sunucuyu başlatın",
        d: "http://localhost:8080 adresini açın. İlk girişte TOTP 2FA kurulur — QR'ı okutun, kurtarma kodlarını saklayın.",
        code: "cd backend && ../.venv/bin/python -m korkut.api",
      },
    ],
  },
  {
    id: "windows",
    label: "Windows",
    prereq: "Gereksinim: Python 3.12+ ve Node 20+. Komutları PowerShell'de çalıştırın.",
    steps: [
      { t: "Depoyu klonlayın", d: "PowerShell açın ve projeyi indirin.", code: clone },
      {
        t: "Kurulum betiğini çalıştırın",
        d: ".venv oluşturur, backend'i kurar, arayüzü derler ve otomatik bir .env yazar.",
        code: "./scripts/install.ps1",
      },
      {
        t: "Bir model tanımlayın",
        d: ".env dosyasına GROQ_API_KEY ya da ANTHROPIC_API_KEY ekleyin; veya girişten sonra Ayarlar → Model'den yerel bir uç noktaya bağlanın (örn. LM Studio: http://localhost:1234/v1).",
        code: null,
      },
      {
        t: "İlk kullanıcıyı oluşturun",
        d: "Sizden bir parola istenecek.",
        code: 'cd backend; ..\\.venv\\Scripts\\python -m korkut.api.adduser avukat --name "Av. Ad Soyad"',
      },
      {
        t: "Sunucuyu başlatın",
        d: "http://localhost:8080 adresini açın. İlk girişte TOTP 2FA kurulur — QR'ı okutun, kurtarma kodlarını saklayın.",
        code: "cd backend; ..\\.venv\\Scripts\\python -m korkut.api",
      },
    ],
  },
  {
    id: "docker",
    label: "Docker",
    prereq: "Gereksinim: Docker + Compose v2. Yerel Python/Node gerekmez.",
    steps: [
      { t: "Depoyu klonlayın", d: "Projeyi indirin.", code: clone },
      {
        t: "Docker modunda kurun",
        d: ".env yazar ve tüm yığını (web + zamanlanmış gönderim + entegrasyon toplayıcı) ayağa kaldırır. Windows'ta: ./scripts/install.ps1 -Docker",
        code: "./scripts/install.sh --docker",
      },
      {
        t: "İlk kullanıcıyı oluşturun",
        d: "Kullanıcıyı çalışan konteyner içinde tanımlayın.",
        code:
          'docker compose -f deploy/docker-compose.yml exec korkut \\\n  python -m korkut.api.adduser avukat --name "Av. Ad Soyad"',
      },
      {
        t: "Uygulamayı açın",
        d: "http://localhost:8090 adresini açın. İlk girişte TOTP 2FA kurulur. Durdurmak için: docker compose -f deploy/docker-compose.yml down.",
        code: null,
      },
    ],
  },
];
---

<section id="kurulum" class="band">
  <div class="wrap center">
    <span class="eyebrow">Kurulum</span>
    <h2>Beş dakikada, kendi makinenizde</h2>
    <p class="section-lead">
      Demo beklemeye gerek yok — indirip kurun. İşletim sisteminizi seçin,
      adımları sırayla uygulayın. Tüm komutlar resmî kurulum dokümanıyla birebirdir.
    </p>
  </div>

  <div class="wrap">
    <div class="os-tabs">
      {tabs.map((t) => (
        <input
          type="radio"
          name="os"
          id={`os-${t.id}`}
          checked={t.checked}
          hidden
        />
      ))}

      <div class="tablist" role="tablist" aria-label="İşletim sistemi seçin">
        {tabs.map((t) => (
          <label class="tab" for={`os-${t.id}`}>{t.label}</label>
        ))}
      </div>

      <div class="panels">
        {tabs.map((t) => (
          <div class={`panel panel-${t.id}`}>
            <p class="prereq">{t.prereq}</p>
            <ol class="steps">
              {t.steps.map((s, i) => (
                <li class="step">
                  <div class="step-num">{i + 1}</div>
                  <div class="step-body">
                    <h3>{s.t}</h3>
                    <p>{s.d}</p>
                    {s.code && (
                      <div class="code">
                        <button class="copy" type="button" aria-label="Komutu kopyala">
                          Kopyala
                        </button>
                        <pre><code>{s.code}</code></pre>
                      </div>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </div>

    <p class="install-foot">
      Ayrıntılı adımlar, üretim kurulumu ve elle kurulum için
      <a href={INSTALL_DOCS_URL} target="_blank" rel="noopener">kurulum dokümanına</a>
      bakın. Sorun mu yaşadınız?
      <a href={`${GITHUB_URL}/issues`} target="_blank" rel="noopener">GitHub Issues</a>
      üzerinden yazın.
    </p>
  </div>
</section>

<style>
  .os-tabs {
    margin-top: 44px;
    max-width: 860px;
    margin-inline: auto;
  }
  .tablist {
    display: inline-flex;
    gap: 4px;
    padding: 5px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    margin-bottom: 28px;
  }
  .tab {
    padding: 9px 20px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14.5px;
    color: var(--muted);
    cursor: pointer;
    transition: 0.15s ease;
    user-select: none;
  }
  .tab:hover {
    color: var(--ink);
  }
  .panel {
    display: none;
    text-align: left;
  }

  /* CSS-only sekme mantığı: seçili radyo, ilgili etiketi ve paneli gösterir. */
  #os-macos:checked ~ .tablist label[for="os-macos"],
  #os-linux:checked ~ .tablist label[for="os-linux"],
  #os-windows:checked ~ .tablist label[for="os-windows"],
  #os-docker:checked ~ .tablist label[for="os-docker"] {
    background: var(--ink);
    color: #fff;
  }
  #os-macos:checked ~ .panels .panel-macos,
  #os-linux:checked ~ .panels .panel-linux,
  #os-windows:checked ~ .panels .panel-windows,
  #os-docker:checked ~ .panels .panel-docker {
    display: block;
  }
  .tab:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .prereq {
    font-size: 14px;
    color: var(--muted);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 16px;
    margin-bottom: 24px;
  }

  .steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .step {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    position: relative;
    padding-bottom: 20px;
  }
  /* Adımları birbirine bağlayan dikey çizgi */
  .step:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 19px;
    top: 40px;
    bottom: 0;
    width: 2px;
    background: var(--line);
  }
  .step-num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-weight: 800;
    display: grid;
    place-items: center;
    z-index: 1;
  }
  .step-body h3 {
    font-size: 17px;
    margin: 8px 0 6px;
    letter-spacing: -0.01em;
  }
  .step-body > p {
    color: var(--muted);
    font-size: 14.5px;
    margin-bottom: 12px;
  }

  .code {
    position: relative;
    background: #0a0a0a;
    border-radius: 12px;
    overflow: hidden;
  }
  .code pre {
    margin: 0;
    padding: 16px 18px;
    overflow-x: auto;
  }
  .code code {
    font-family: "SFMono-Regular", ui-monospace, "Menlo", "Consolas", monospace;
    font-size: 13.5px;
    line-height: 1.7;
    color: #f2f2f2;
    white-space: pre;
  }
  .copy {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 12px;
    font-weight: 600;
    color: #cfcfcf;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 7px;
    padding: 5px 10px;
    cursor: pointer;
    transition: 0.15s ease;
  }
  .copy:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }
  .copy.copied {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.4);
  }

  .install-foot {
    text-align: center;
    color: var(--muted);
    font-size: 14.5px;
    margin: 36px auto 0;
    max-width: 620px;
  }
  .install-foot a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 560px) {
    .tablist {
      display: flex;
      flex-wrap: wrap;
      border-radius: 16px;
    }
  }
</style>

<script>
  // Komut kopyalama düğmeleri — JS olmadan da kod görünür (aşamalı geliştirme).
  document.querySelectorAll<HTMLButtonElement>(".copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const code = btn.parentElement?.querySelector("code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        const prev = btn.textContent;
        btn.textContent = "Kopyalandı ✓";
        btn.classList.add("copied");
        setTimeout(() => {
          btn.textContent = prev;
          btn.classList.remove("copied");
        }, 1600);
      } catch {
        /* pano erişimi yoksa sessizce geç */
      }
    });
  });
</script>
