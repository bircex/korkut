---
// Kurum logoları resmî sitelerinden alınmıştır; her biri ilgili kuruma aittir.
const sources = [
  { logo: "/logos/sources/yargitay.png", name: "Yargıtay", sub: "Temyiz kararları & içtihat" },
  { logo: "/logos/sources/danistay.png", name: "Danıştay", sub: "İdari yargı içtihadı" },
  { logo: "/logos/sources/anayasa.png", name: "Anayasa Mahkemesi", sub: "Bireysel başvuru & norm denetimi" },
  { logo: "/logos/sources/uyap.png", name: "UYAP Emsal", sub: "Yerel mahkeme emsal kararları" },
  { logo: "/logos/sources/mevzuat.png", name: "Mevzuat", sub: "Kanun, KHK & yönetmelik metinleri" },
  { logo: "/logos/sources/resmigazete.png", name: "Resmî Gazete", sub: "Güncel resmî yayımlar" },
  { logo: "/logos/sources/rekabet.png", name: "Rekabet Kurumu", sub: "Rekabet Kurulu kararları" },
  { logo: "/logos/sources/sayistay.png", name: "Sayıştay", sub: "Denetim & temyiz kararları" },
  { logo: "/logos/sources/ihale.png", name: "KİK", sub: "Kamu İhale Kurulu kararları" },
  { logo: "/logos/sources/gib.png", name: "GİB", sub: "Özelge, tebliğ & sirküler" },
  { logo: "/logos/sources/kvkk.png", name: "KVKK", sub: "Veri Koruma Kurulu kararları" },
];
// İki kopya: kesintisiz (seamless) kayan şerit için.
const loop = [...sources, ...sources];
const base = import.meta.env.BASE_URL; // "/korkut/" alt yolunda, apex'te "/"
---

<section id="kaynaklar">
  <div class="wrap center">
    <span class="eyebrow">Veri kaynakları</span>
    <h2>Türkiye'nin resmî hukuki kaynaklarından</h2>
    <p class="section-lead">
      Araştırma modülü, resmî ve yarı-resmî kaynaklarda canlı arama yapar,
      sonuçları özetler ve <strong>daima kaynak gösterir</strong>. Uydurma
      atıfları önlemek için her sonuç kaynağına bağlanır.
    </p>

    <div class="src-stats">
      <div class="src-stat">
        <b>10M+</b>
        <span>karar &amp; mevzuat belgesine erişim</span>
      </div>
      <div class="src-stat">
        <b>11</b>
        <span>resmî &amp; yarı-resmî kaynak</span>
      </div>
      <div class="src-stat">
        <b>Canlı</b>
        <span>arama &amp; daima atıf</span>
      </div>
    </div>
  </div>

  <!-- Kaynaklar kayan şerit (slider). Duraklatmak için üzerine gelin. -->
  <div class="marquee">
    <ul class="marquee-track">
      {
        loop.map((s, i) => (
          <li class="src-tile" aria-hidden={i >= sources.length ? "true" : undefined}>
            <div class="src-logo">
              <img src={`${base}${s.logo.slice(1)}`} alt={`${s.name} logosu`} loading="lazy" />
            </div>
            <div class="src-text">
              <b>{s.name}</b>
              <span>{s.sub}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="wrap center">
    <p class="src-note">
      Kaynak listesi büyümeye devam ediyor; Uyuşmazlık Mahkemesi, BDDK ve sigorta
      tahkim kararları da kapsam dahilindedir.
    </p>
  </div>
</section>

<style>
  .src-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px 52px;
    margin-top: 40px;
  }
  .src-stat b {
    display: block;
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .src-stat span {
    color: var(--muted);
    font-size: 14px;
  }

  /* Full-bleed kayan şerit, kenarlarda yumuşak solma (fade) maskesiyle. */
  .marquee {
    margin-top: 48px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 7%,
      #000 93%,
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 7%,
      #000 93%,
      transparent
    );
  }
  .marquee-track {
    display: flex;
    width: max-content;
    list-style: none;
    animation: src-scroll 46s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  @keyframes src-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* Şerit iki özdeş kopyadan oluşur; yarısı kadar kaydırınca kesintisiz döner. */
      transform: translateX(-50%);
    }
  }

  .src-tile {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: none;
    width: 248px;
    margin-right: 16px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 16px 18px;
    text-align: left;
  }
  .src-logo {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--bg-soft);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .src-logo img {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }
  .src-text b {
    display: block;
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .src-text span {
    color: var(--muted);
    font-size: 13px;
  }
  .src-note {
    color: var(--muted);
    font-size: 14.5px;
    margin: 32px auto 0;
    max-width: 620px;
  }

  /* Hareket azaltma tercihinde şerit durur ve merkezli grid'e döner. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
      max-width: var(--maxw);
      margin: 0 auto;
      padding: 0 24px;
    }
    .src-tile[aria-hidden="true"] {
      display: none;
    }
  }
</style>
