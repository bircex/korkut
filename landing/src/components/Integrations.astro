---
const integrations = [
  {
    logo: "/logos/telegram.svg",
    name: "Telegram",
    body: "Bot üzerinden iki yönlü mesajlaşma; sorularınızı yazın, yanıtları kanalda alın.",
  },
  {
    logo: "/logos/whatsapp.svg",
    name: "WhatsApp",
    body: "Müvekkil ve karşı taraf yazışmalarını WhatsApp üzerinden yürütün.",
  },
  {
    logo: "/logos/email.svg",
    name: "E-posta (SMTP/IMAP)",
    body: "Öner-ve-onayla mantığıyla e-posta taslakları; siz onaylamadan gönderilmez.",
  },
];
const base = import.meta.env.BASE_URL; // "/korkut/" alt yolunda, apex'te "/"
---

<section id="entegrasyonlar">
  <div class="wrap center">
    <span class="eyebrow">Entegrasyonlar</span>
    <h2>Mevcut kanallarınıza bağlanır</h2>
    <p class="section-lead">
      Korkut, büronuzun zaten kullandığı iletişim kanalları üzerinden çalışır.
      Her giden mesaj önce sizin onayınızdan geçer.
    </p>

    <div class="int-grid">
      {
        integrations.map((i) => (
          <article class="int-card">
            <div class="int-logo">
              <img src={`${base}${i.logo.slice(1)}`} alt={`${i.name} logosu`} width="28" height="28" loading="lazy" />
            </div>
            <h3>{i.name}</h3>
            <p>{i.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .int-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 52px;
    text-align: left;
  }
  @media (max-width: 820px) {
    .int-grid {
      grid-template-columns: 1fr;
    }
  }
  .int-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px;
    transition: 0.18s ease;
  }
  .int-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .int-logo {
    width: 54px;
    height: 54px;
    border-radius: 13px;
    border: 1px solid var(--line);
    background: var(--bg-soft);
    display: grid;
    place-items: center;
    margin-bottom: 18px;
  }
  .int-logo img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }
  .int-card h3 {
    font-size: 17.5px;
    margin-bottom: 7px;
  }
  .int-card p {
    color: var(--muted);
    font-size: 14.5px;
  }
</style>
