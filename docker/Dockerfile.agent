# KDM-009 — hardened Korkut.Agent image (the stateless AI host).
# Multi-stage: SDK builds/publishes; the final image is a chiseled ASP.NET runtime
# (no shell, no package manager, non-root 'app' UID 1654 by default). Base images
# are pinned by digest for reproducibility. Build context is the repository root.

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0.302@sha256:ed034a8bf0b24ded0cbbac07e17825d8e9ebfe21e308191d0f7421eaf5ad4664 AS build
WORKDIR /src

# Restore with only the project graph + central config (better layer caching).
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/ ./src/
RUN dotnet restore src/services/Korkut.Agent.Host/Korkut.Agent.Host.csproj
RUN dotnet publish src/services/Korkut.Agent.Host/Korkut.Agent.Host.csproj \
    -c Release -o /app --no-restore /p:UseAppHost=false

# Final stage — chiseled, non-root, minimal.
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled@sha256:70d6f993bf715a031f027832a19cfb7f894df66c8b5eb40be0aaee820ad5d119 AS final
WORKDIR /app
COPY --from=build /app ./

# Bind on 8080 (non-privileged). Runtime config comes from the environment, never
# baked into the image.
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_EnableDiagnostics=0
EXPOSE 8080

# Runs as the chiseled 'app' user (UID 1654) — never root.
USER app

# Liveness/readiness are the /health/live and /health/ready endpoints (KDM-007),
# probed by the orchestrator; chiseled images ship no shell/curl for a Docker
# HEALTHCHECK, so health is delegated to orchestrator probes.
ENTRYPOINT ["dotnet", "Korkut.Agent.Host.dll"]
