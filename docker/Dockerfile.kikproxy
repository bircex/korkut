# Korkut.KikProxy — a single-purpose sidecar for one legacy .gov.tr host (ekap.kik.gov.tr).
# Multi-stage: SDK builds/publishes; the final image is a chiseled ASP.NET runtime (no shell, no
# package manager, non-root 'app' UID 1654), same hardening as every other host. The ONE
# difference from Korkut.Agent/Korkut.Api: OPENSSL_CONF points at a relaxed cipher-suite policy
# (docker/kikproxy-openssl.cnf) that ekap.kik.gov.tr's handshake needs. That relaxation must never
# reach the main Api/Agent processes (it would weaken their calls to the model providers too) —
# this whole service exists so it stays contained to a process that talks to nothing else.
# Build context is the repository root.

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0.402@sha256:747cbade5bfd918a175ac32f8f1d931edec2c7d0d5397a3de72eaef1ac1f66d2 AS build
WORKDIR /src

# Restore with only the project graph + central config (better layer caching).
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/services/Korkut.KikProxy/ ./src/services/Korkut.KikProxy/
RUN dotnet restore src/services/Korkut.KikProxy/Korkut.KikProxy.csproj
ARG KORKUT_VERSION=local
RUN dotnet publish src/services/Korkut.KikProxy/Korkut.KikProxy.csproj \
    -c Release -o /app --no-restore /p:UseAppHost=false \
    /p:InformationalVersion=${KORKUT_VERSION}

# Final stage — chiseled, non-root, minimal.
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled@sha256:5165aeeb688df15e869a56a7584bb94bf16a14e0b3ba77b49fcdbe350f6b8020 AS final
# Release metadata: the CalVer version this image was built as, and where it comes from (the
# source label also links the published GHCR package to the repository).
ARG KORKUT_VERSION=local
LABEL org.opencontainers.image.title="Korkut KİK proxy" \
      org.opencontainers.image.version="${KORKUT_VERSION}" \
      org.opencontainers.image.source="https://github.com/bircex/korkut" \
      org.opencontainers.image.licenses="MIT"
ENV KORKUT_VERSION=${KORKUT_VERSION}
WORKDIR /app
COPY --from=build /app ./
COPY docker/kikproxy-openssl.cnf /app/openssl-legacy.cnf

# Bind on 8080 (non-privileged). No secrets, no DB — this host holds no config beyond its own port.
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_EnableDiagnostics=0 \
    OPENSSL_CONF=/app/openssl-legacy.cnf
EXPOSE 8080

# Runs as the chiseled 'app' user (UID 1654) — never root.
USER app

# Liveness/readiness are the /health/live and /health/ready endpoints; chiseled images ship no
# shell/curl for a Docker HEALTHCHECK, so health is delegated to orchestrator probes.
ENTRYPOINT ["dotnet", "Korkut.KikProxy.dll"]
