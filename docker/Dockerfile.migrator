# KDM-009 — hardened Korkut.Migrator image. One-shot: applies migrations then exits
# (chiseled runtime, non-root, digest-pinned). Runs under a separate least-privileged
# DB identity (KDM-011); never runs inside the app.
FROM mcr.microsoft.com/dotnet/sdk:10.0.402@sha256:747cbade5bfd918a175ac32f8f1d931edec2c7d0d5397a3de72eaef1ac1f66d2 AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/ ./src/
RUN dotnet restore src/services/Korkut.Migrator/Korkut.Migrator.csproj
ARG KORKUT_VERSION=local
RUN dotnet publish src/services/Korkut.Migrator/Korkut.Migrator.csproj \
    -c Release -o /app --no-restore /p:UseAppHost=false \
    /p:InformationalVersion=${KORKUT_VERSION}

FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled AS final
# Release metadata: the CalVer version this image was built as, and where it comes from (the
# source label also links the published GHCR package to the repository).
ARG KORKUT_VERSION=local
LABEL org.opencontainers.image.title="Korkut migrator" \
      org.opencontainers.image.version="${KORKUT_VERSION}" \
      org.opencontainers.image.source="https://github.com/bircex/korkut" \
      org.opencontainers.image.licenses="MIT"
ENV KORKUT_VERSION=${KORKUT_VERSION}
WORKDIR /app
COPY --from=build /app ./
ENV DOTNET_EnableDiagnostics=0
USER app
ENTRYPOINT ["dotnet", "Korkut.Migrator.dll"]
CMD ["info"]
