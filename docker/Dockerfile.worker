# KDM-009 — hardened Korkut.Worker image (chiseled runtime, non-root, digest-pinned).
FROM mcr.microsoft.com/dotnet/sdk:10.0.302@sha256:ed034a8bf0b24ded0cbbac07e17825d8e9ebfe21e308191d0f7421eaf5ad4664 AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/ ./src/
RUN dotnet restore src/services/Korkut.Worker/Korkut.Worker.csproj
RUN dotnet publish src/services/Korkut.Worker/Korkut.Worker.csproj \
    -c Release -o /app --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:10.0-noble-chiseled@sha256:4b12cfda4e6e0b3c855ae01dc4b22544d48d0d3b4aca74ce5f9c627b0ed030b2 AS final
WORKDIR /app
COPY --from=build /app ./
ENV DOTNET_EnableDiagnostics=0
USER app
# The Generic Host stops hosted services gracefully on SIGTERM; the outbox loop
# honours the stopping token (KDM-008).
ENTRYPOINT ["dotnet", "Korkut.Worker.dll"]
