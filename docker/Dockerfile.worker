# KDM-009 — hardened Korkut.Worker image (chiseled runtime, non-root, digest-pinned).
FROM mcr.microsoft.com/dotnet/sdk:10.0.302@sha256:72dd743782f2ae7e5476fd64f6a460045e3998dc862218b80e6944cba79a01b0 AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/ ./src/
RUN dotnet restore src/services/Korkut.Worker/Korkut.Worker.csproj
RUN dotnet publish src/services/Korkut.Worker/Korkut.Worker.csproj \
    -c Release -o /app --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled AS final
WORKDIR /app
COPY --from=build /app ./
# The legal template catalog (petition/contract skeletons + intake schemas) ships in the
# image — TemplateCatalog resolves it via KORKUT_TEMPLATES_DIR at startup.
COPY templates/ /app/templates/
ENV DOTNET_EnableDiagnostics=0 \
    KORKUT_TEMPLATES_DIR=/app/templates
USER app
# The Generic Host stops hosted services gracefully on SIGTERM; the outbox loop
# honours the stopping token (KDM-008).
ENTRYPOINT ["dotnet", "Korkut.Worker.dll"]
