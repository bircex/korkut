# KDM-009 — Korkut.Ocr image (the heavy, rare, on-demand OCR host).
# Multi-stage: SDK builds/publishes; the final image is a chiseled ASP.NET runtime
# (no shell, non-root 'app'). Base images pinned by digest. Build context is the repo root.
#
# The native engine ships IN this image (tesseract + tesseract-ocr-tur/eng + poppler-utils, see the
# final stage), which is why the base is the full noble runtime and not the chiseled one. The image
# alone is not enough though: the host still starts on the DisabledOcrService scaffold (→ 503) unless
# KORKUT_OCR_ENGINE=tesseract is set in the environment (see Korkut.Ocr/Program.cs). Both compose
# files set it; a deployment that does not will answer 503 to every /extract with no other symptom.

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0.402@sha256:0d99ebf1ccad15037b5c98c9fe8979d6b8dbac23812feae2277a0b277b5c5ffa AS build
WORKDIR /src

# Restore with only the project graph + central config (better layer caching).
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/ ./src/
RUN dotnet restore src/services/Korkut.Ocr/Korkut.Ocr.csproj
RUN dotnet publish src/services/Korkut.Ocr/Korkut.Ocr.csproj \
    -c Release -o /app --no-restore /p:UseAppHost=false

# Final stage — full noble runtime (NOT chiseled) so the native OCR binaries can be installed.
# Tesseract (+ Turkish/English data) does the recognition; poppler-utils' pdftoppm rasterises PDFs.
# Enable the real engine at runtime with KORKUT_OCR_ENGINE=tesseract (see Korkut.Ocr/Program.cs).
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble AS final
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-tur tesseract-ocr-eng poppler-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app ./

# Bind on 8080 (non-privileged). Runtime config comes from the environment (KORKUT_SECRET).
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_EnableDiagnostics=0
EXPOSE 8080

# Mount point for the generated secrets volume, owned by the app user so either host can create it.
RUN mkdir -p /var/lib/korkut/secrets && chown 1654:1654 /var/lib/korkut/secrets

# Run as a non-root user (the noble image ships 'app', UID 1654).
USER app

# Liveness/readiness via /health/live and /health/ready, probed by the orchestrator.
ENTRYPOINT ["dotnet", "Korkut.Ocr.dll"]
