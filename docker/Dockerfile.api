# KDM-009 — hardened Korkut.Api image.
# Multi-stage: SDK builds/publishes; the final image is a chiseled ASP.NET runtime
# (no shell, no package manager, non-root 'app' UID 1654 by default). Base images
# are pinned by digest for reproducibility. Build context is the repository root.

# SPA stage: the React app in ui/, built once and served by this host as static files.
FROM node:26-alpine AS ui
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0.402@sha256:0d99ebf1ccad15037b5c98c9fe8979d6b8dbac23812feae2277a0b277b5c5ffa AS build
WORKDIR /src

# Restore with only the project graph + central config (better layer caching).
COPY global.json Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src/ ./src/
RUN dotnet restore src/services/Korkut.Api/Korkut.Api.csproj
RUN dotnet publish src/services/Korkut.Api/Korkut.Api.csproj \
    -c Release -o /app --no-restore /p:UseAppHost=false

# The document store's and the generated secrets' mount points, created here because the runtime
# image has no shell. A named volume mounted on one starts out with this owner, so the non-root app
# user can write to it.
RUN mkdir -p /objects /secrets

# Final stage — chiseled, non-root, minimal.
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled@sha256:84def277556c2843a44fdeefbd3145d0a2e32d8f736d0c1a7b0a96b2880b0187 AS final
WORKDIR /app
COPY --from=build /app ./
COPY --from=ui /ui/dist ./wwwroot
COPY --from=build --chown=1654:1654 /objects /var/lib/korkut/objects
COPY --from=build --chown=1654:1654 /secrets /var/lib/korkut/secrets
# The legal template catalog (petition/contract skeletons + intake schemas) ships in the
# image — TemplateCatalog resolves it via KORKUT_TEMPLATES_DIR at startup.
COPY templates/ /app/templates/

# Bind on 8080 (non-privileged). Runtime config comes from the environment, never
# baked into the image.
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_EnableDiagnostics=0 \
    KORKUT_TEMPLATES_DIR=/app/templates
EXPOSE 8080

# Runs as the chiseled 'app' user (UID 1654) — never root.
USER app

# Liveness/readiness are the /health/live and /health/ready endpoints (KDM-007),
# probed by the orchestrator; chiseled images ship no shell/curl for a Docker
# HEALTHCHECK, so health is delegated to orchestrator probes.
ENTRYPOINT ["dotnet", "Korkut.Api.dll"]
