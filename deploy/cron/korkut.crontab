# Korkut background workers (non-Docker hosts).
# Install with:  crontab deploy/cron/korkut.crontab   (adjust the paths to your install).
# In Docker, the compose `dispatcher` + `integrations` services do this automatically — no crontab.

# Scheduled-send worker: flushes due outbound messages ("X tarihinde gönder", reminders) every minute.
* * * * * cd /opt/korkut/backend && /opt/korkut/.venv/bin/python -m korkut.api.dispatcher >> /var/log/korkut-dispatcher.log 2>&1

# Two-way integrations runner: answers inbound Telegram/WhatsApp/e-mail messages. Cron's finest
# granularity is one minute; the runner exits after one pass, so this polls once a minute.
* * * * * cd /opt/korkut/backend && /opt/korkut/.venv/bin/python -m korkut.integrations.runner >> /var/log/korkut-integrations.log 2>&1
