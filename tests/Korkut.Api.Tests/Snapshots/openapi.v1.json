{
  "components": {
    "schemas": {
      "ClientWriteRequest": {
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "kind": {
            "pattern": "individual|corporate",
            "type": "string"
          },
          "name": {
            "maxLength": "300",
            "type": [
              "null",
              "string"
            ]
          },
          "phone": {
            "maxLength": "50",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "DeadlineCreateRequest": {
        "properties": {
          "due_date": {
            "format": "date",
            "type": "string"
          },
          "kind": {
            "pattern": "statutory|internal",
            "type": "string"
          },
          "matter_id": {
            "format": "uuid",
            "type": [
              "null",
              "string"
            ]
          },
          "reminder_days_before": {
            "format": "int32",
            "maximum": "365",
            "minimum": "0",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          },
          "time_zone_id": {
            "type": "string"
          },
          "title": {
            "maxLength": "500",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "title",
          "due_date"
        ],
        "type": "object"
      },
      "EchoRequest": {
        "properties": {
          "title": {
            "maxLength": "200",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "IFormFile": {
        "format": "binary",
        "type": "string"
      },
      "InviteAcceptRequest": {
        "properties": {
          "token": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "InviteCreateRequest": {
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "pattern": "owner|lawyer",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "email",
          "role"
        ],
        "type": "object"
      },
      "LinkRequest": {
        "properties": {
          "is_primary": {
            "type": "boolean"
          },
          "target_id": {
            "format": "uuid",
            "type": "string"
          },
          "target_type": {
            "pattern": "client|matter|party",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "target_type",
          "target_id"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "MatterCreateRequest": {
        "properties": {
          "client_id": {
            "format": "uuid",
            "type": [
              "null",
              "string"
            ]
          },
          "court_id": {
            "format": "uuid",
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "maxLength": "500",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "MemberCreateRequest": {
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "pattern": "owner|lawyer",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "email",
          "role"
        ],
        "type": "object"
      },
      "MemberRoleRequest": {
        "properties": {
          "role": {
            "pattern": "owner|lawyer",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "NoteCreateRequest": {
        "properties": {
          "body": {
            "maxLength": "4000",
            "type": [
              "null",
              "string"
            ]
          },
          "channel": {
            "type": "string"
          },
          "client_id": {
            "format": "uuid",
            "type": [
              "null",
              "string"
            ]
          },
          "matter_id": {
            "format": "uuid",
            "type": [
              "null",
              "string"
            ]
          },
          "occurred_at": {
            "format": "date-time",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "body"
        ],
        "type": "object"
      },
      "ResetBody": {
        "properties": {
          "password": {
            "minLength": "10",
            "type": [
              "null",
              "string"
            ]
          },
          "token": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "token",
          "password"
        ],
        "type": "object"
      },
      "ResetRequestBody": {
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "TaskCreateRequest": {
        "properties": {
          "assignee_id": {
            "format": "uuid",
            "type": [
              "null",
              "string"
            ]
          },
          "due_at": {
            "format": "date-time",
            "type": [
              "null",
              "string"
            ]
          },
          "matter_id": {
            "format": "uuid",
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "maxLength": "500",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "TaskStatusRequest": {
        "properties": {
          "status": {
            "pattern": "open|in_progress|done",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "TotpRequest": {
        "properties": {
          "code": {
            "type": [
              "null",
              "string"
            ]
          },
          "recovery_code": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      }
    }
  },
