<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fast, isolated unit tests for the Finance module (no DB). Can reach module internals
       (repositories/service impl) via [InternalsVisibleTo] declared on Korkut.Finance. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\modules\Korkut.Finance\Korkut.Finance.csproj" />
    <ProjectReference Include="..\..\..\src\shared\Korkut.Contract\Korkut.Contract.csproj" />
  </ItemGroup>
</Project>
