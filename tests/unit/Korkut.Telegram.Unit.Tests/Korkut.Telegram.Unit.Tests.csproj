<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fast, isolated unit tests for the Telegram module (no DB, no network). Reaches module
       internals via [InternalsVisibleTo] declared on Korkut.Telegram. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\modules\Korkut.Telegram\Korkut.Telegram.csproj" />
  </ItemGroup>
</Project>
