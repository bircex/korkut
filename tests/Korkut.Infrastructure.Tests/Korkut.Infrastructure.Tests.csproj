<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Each test class spins its own real Postgres container; serialize classes so CI
         runners don't hit a container-startup thundering herd. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Minio" />
    <PackageReference Include="Minio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\modules\Korkut.Agent.Brain\Korkut.Agent.Brain.csproj" />
    <ProjectReference Include="..\..\src\modules\Korkut.Agent.Model\Korkut.Agent.Model.csproj" />
    <ProjectReference Include="..\..\src\modules\Korkut.Tools\Korkut.Tools.csproj" />
    <ProjectReference Include="..\..\src\shared\Korkut.Infrastructure\Korkut.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\shared\Korkut.Application\Korkut.Application.csproj" />
  </ItemGroup>
</Project>
