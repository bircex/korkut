<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- Mirror the Web SDK's implicit global usings, since this is a plain library that
       nonetheless builds against ASP.NET Core (FrameworkReference above). -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <!-- The web foundation shared by every host (Korkut.Api, Korkut.Agent): auth,
         JSON contract, error mapping, tenant bridge, host setup. -->
    <ProjectReference Include="..\Korkut.Application\Korkut.Application.csproj" />
    <ProjectReference Include="..\Korkut.Infrastructure\Korkut.Infrastructure.csproj" />
    <ProjectReference Include="..\Korkut.Domain\Korkut.Domain.csproj" />
    <ProjectReference Include="..\Korkut.Clients\Korkut.Clients.csproj" />
    <ProjectReference Include="..\Korkut.Notes\Korkut.Notes.csproj" />
    <ProjectReference Include="..\Korkut.Tasks\Korkut.Tasks.csproj" />
    <ProjectReference Include="..\Korkut.Deadlines\Korkut.Deadlines.csproj" />
    <ProjectReference Include="..\Korkut.Channels\Korkut.Channels.csproj" />
    <ProjectReference Include="..\Korkut.Correspondence\Korkut.Correspondence.csproj" />
  </ItemGroup>
</Project>
