---
// Yetenekler — attacklens.io "Discover and assess" bölümü gibi sekmeli showcase.
// Her sekmenin sağ tarafındaki panele ekran görüntüsü/video gelecek:
//   shot: "/shots/arastirma.png"  → görsel
//   video: "/shots/dilekce.mp4"   → video
// İkisi de boşsa yer tutucu (placeholder) gösterilir.
const tabs = [
  {
    id: "arastirma",
    tab: "Araştırma",
    title: "İçtihat & mevzuat araştırması",
    body: "Yargıtay, Danıştay, UYAP Emsal, Anayasa Mahkemesi ve mevzuatta canlı arama yapar; emsalleri özetler ve daima kaynak gösterir.",
    points: [
      "11 resmî ve yarı-resmî kaynakta tek arayüzden arama",
      "Sonuçları özetler, uydurma atıfları önlemek için kaynağa bağlar",
      "Resmî Gazete tarih ve sayı filtresiyle tam metin taraması",
    ],
    shot: null,
    video: null,
  },
  {
    id: "dilekce",
    tab: "Dilekçe",
    title: "Dilekçe & sözleşme taslağı",
    body: "Canvas editöründe dava türüne uygun dilekçe ve sözleşme taslakları üretir; birlikte düzenler, DOCX/UDF olarak dışa aktarır.",
    points: [
      "Canvas editöründe canlı, madde madde düzenleme",
      "İçtihada dayanan taslak; onayınıza sunulur",
      "DOCX ve UYAP (UDF) formatında dışa aktarım",
    ],
    shot: null,
    video: null,
  },
  {
    id: "gundem",
    tab: "Dosya & gündem",
    title: "Dosya, duruşma & süre takibi",
    body: "Müvekkiller, duruşmalar ve usul sürelerini tek yerde tutar; yaklaşan işleri önden gösteren proaktif bir gündem sunar.",
    points: [
      "Müvekkil, dosya, duruşma ve süreler tek panelde",
      "Yaklaşan duruşma ve süreler için proaktif gündem",
      "Onaysız hiçbir kayıt oluşturulmaz",
    ],
    shot: null,
    video: null,
  },
  {
    id: "yazisma",
    tab: "Yazışma",
    title: "Kanallar arası yazışma",
    body: "Telegram, WhatsApp ve e-posta üzerinden iki yönlü iletişim; öner-ve-onayla mantığıyla hiçbir mesaj siz onaylamadan gitmez.",
    points: [
      "Telegram, WhatsApp ve e-posta (SMTP/IMAP) entegrasyonu",
      "Öner-ve-onayla: giden her mesaj önce önünüze gelir",
      "Yanıtlar doğrudan ilgili dosyayla ilişkilenir",
    ],
    shot: null,
    video: null,
  },
];
---

<section id="ozellikler">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">Yetenekler</span>
      <h2>Büronun günlük işini tek asistan yürütür</h2>
      <p class="section-lead">
        Araştırmadan dilekçeye, dosya takibinden yazışmaya — hepsi tek bir
        sohbetten. Bir yeteneği seçin, nasıl çalıştığını görün.
      </p>
    </div>

    <div class="feat-tabs">
      {tabs.map((t, i) => (
        <input
          type="radio"
          name="feat"
          id={`feat-${t.id}`}
          checked={i === 0}
          hidden
        />
      ))}

      <div class="tablist" role="tablist" aria-label="Yetenekler">
        {tabs.map((t) => (
          <label class="tab" for={`feat-${t.id}`}>{t.tab}</label>
        ))}
      </div>

      <div class="panels">
        {tabs.map((t) => (
          <div class={`panel panel-${t.id}`}>
            <div class="panel-text">
              <h3>{t.title}</h3>
              <p>{t.body}</p>
              <ul class="checks">
                {t.points.map((p) => (
                  <li>
                    <span class="tick" aria-hidden="true">✓</span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="panel-media">
              <div class="frame">
                <div class="frame-bar" aria-hidden="true">
                  <span></span><span></span><span></span>
                </div>
                <div class="frame-body">
                  {t.video ? (
                    <video src={t.video} muted autoplay loop playsinline preload="metadata"></video>
                  ) : t.shot ? (
                    <img src={t.shot} alt={`${t.title} ekran görüntüsü`} loading="lazy" />
                  ) : (
                    <div class="placeholder">
                      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="14" rx="2" />
                        <path d="M3 15l4-4 3 3 4-5 7 6" />
                        <circle cx="8.5" cy="8.5" r="1.4" />
                      </svg>
                      <b>Ekran görüntüsü / video</b>
                      <span>Bu yeteneğin gösterimi buraya gelecek</span>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  #ozellikler {
    padding-bottom: 96px;
  }
  .head {
    max-width: 640px;
  }
  .feat-tabs {
    margin-top: 40px;
  }
  .tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 18px;
    margin-bottom: 36px;
  }
  .tab {
    padding: 9px 18px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    color: var(--muted);
    cursor: pointer;
    transition: 0.15s ease;
    user-select: none;
    border: 1px solid transparent;
  }
  .tab:hover {
    color: var(--ink);
    background: var(--soft);
  }
  .tab:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .panel {
    display: none;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 48px;
    align-items: center;
  }
  @media (max-width: 900px) {
    .panel {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  /* CSS-only sekme: seçili radyo etiketi vurgular ve panelini gösterir. */
  #feat-arastirma:checked ~ .tablist label[for="feat-arastirma"],
  #feat-dilekce:checked ~ .tablist label[for="feat-dilekce"],
  #feat-gundem:checked ~ .tablist label[for="feat-gundem"],
  #feat-yazisma:checked ~ .tablist label[for="feat-yazisma"] {
    background: var(--ink);
    color: #fff;
  }
  #feat-arastirma:checked ~ .panels .panel-arastirma,
  #feat-dilekce:checked ~ .panels .panel-dilekce,
  #feat-gundem:checked ~ .panels .panel-gundem,
  #feat-yazisma:checked ~ .panels .panel-yazisma {
    display: grid;
  }

  .panel-text h3 {
    font-size: clamp(22px, 2.4vw, 28px);
    letter-spacing: -0.02em;
    font-weight: 800;
    margin-bottom: 14px;
  }
  .panel-text > p {
    color: var(--muted);
    font-size: 17px;
    margin-bottom: 22px;
  }
  .checks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }
  .checks li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 15px;
  }
  .tick {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 800;
    margin-top: 1px;
  }

  /* Görsel / video paneli */
  .frame {
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow-lg);
  }
  .frame-bar {
    display: flex;
    gap: 7px;
    padding: 13px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-soft);
  }
  .frame-bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .frame-body {
    aspect-ratio: 16 / 10;
    background: #0a0a0a;
  }
  .frame-body img,
  .frame-body video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #8a8a8a;
    text-align: center;
    padding: 24px;
    background:
      repeating-linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.02) 0,
        rgba(255, 255, 255, 0.02) 10px,
        transparent 10px,
        transparent 20px
      );
  }
  .placeholder b {
    color: #e6e6e6;
    font-size: 15px;
  }
  .placeholder span {
    font-size: 13px;
  }
</style>
