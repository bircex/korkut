    tabs: [
      {
        id: "kisilik",
        tab: "Kişilik",
        title: "Asistan kişiliği",
        body: "Korkut'un ses tonunu, uzmanlık alanlarını ve büro kurallarını belirleyin. Çekirdek güvenlik/atıf/onay kuralları koddadır; buradan yalnızca üzerine eklersiniz.",
        points: [
          "Üslup ve ses tonu ayarı",
          "Büronun uzmanlık alanları",
          "Çekirdek güvenlik ve onay kuralları değiştirilemez",
        ],
        shot: "/shots/kisilik.png",
        video: null,
      },
      {
        id: "hafiza",
        tab: "Hafıza",
        title: "Kalıcı hafıza",
        body: "Büronun kalıcı tercihlerini ve notlarını her sohbette hatırlar. Korkut'un önerdiği notlar siz onaylayana kadar beklemede kalır; hiçbir şey izinsiz hatırlanmaz.",
        points: [
          "Büro geneli kalıcı notlar ve tercihler",
          "Öner-ve-onayla: onaysız bilgi hatırlanmaz",
          "Buluta giderken maskelenir",
        ],
        shot: "/shots/hafiza.png",
        video: null,
      },
      {
        id: "stil",
        tab: "Stil",
        title: "Antet, imza & belge stili",
        body: "Dilekçe ve sözleşmelerin antetini, imza bloğunu ve üslubunu tek yerden yönetin. Antet ve imza modele gönderilmez; belgeye aynen eklenir.",
        points: [
          "Büro anteti ve imza bloğu",
          "Standart kalıplar (kapanış, vekâlet ücreti…)",
          "Antet/imza buluta gönderilmez",
        ],
        shot: "/shots/stil.png",
        video: null,
      },
    ],
  },
];
const base = import.meta.env.BASE_URL; // "/korkut/" alt yolunda, apex'te "/"
---

<section id="ozellikler">
  <div class="wrap">
    {
      groups.map((g, gi) => (
        <div class={`showcase ${gi > 0 ? "showcase-next" : ""}`}>
          <div class="head">
            <span class="eyebrow">{g.eyebrow}</span>
            <h2>{g.title}</h2>
            <p class="section-lead">{g.lead}</p>
          </div>

          <div
            class="tablist"
            role="tablist"
            aria-label={g.eyebrow}
          >
            {g.tabs.map((t, i) => (
              <button
                class={`tab ${i === 0 ? "is-active" : ""}`}
                role="tab"
                type="button"
                aria-selected={i === 0 ? "true" : "false"}
                aria-controls={`${g.key}-${t.id}`}
              >
                {t.tab}
              </button>
            ))}
          </div>

          <div class="panels">
            {g.tabs.map((t, i) => (
              <div
                class={`panel ${i === 0 ? "is-active" : ""}`}
                id={`${g.key}-${t.id}`}
                role="tabpanel"
              >
                <div class="panel-text">
                  <h3>{t.title}</h3>
                  <p>{t.body}</p>
                  <ul class="checks">
                    {t.points.map((p) => (
                      <li>
                        <span class="tick" aria-hidden="true">✓</span>
                        <span>{p}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="panel-media">
                  <div class="frame">
                    <div class="frame-bar" aria-hidden="true">
                      <span /> <span /> <span />
                    </div>
                    <div class="frame-body">
                      {t.video ? (
                        <video src={`${base}${t.video.slice(1)}`} muted autoplay loop playsinline preload="metadata" />
                      ) : t.shot ? (
                        <img src={`${base}${t.shot.slice(1)}`} alt={`${t.title} ekran görüntüsü`} loading="lazy" />
                      ) : (
                        <div class="placeholder">
                          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="14" rx="2" />
                            <path d="M3 15l4-4 3 3 4-5 7 6" />
                            <circle cx="8.5" cy="8.5" r="1.4" />
                          </svg>
                          <b>Ekran görüntüsü / video</b>
                          <span>Bu yeteneğin gösterimi buraya gelecek</span>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  #ozellikler {
    padding-bottom: 96px;
  }
  .showcase-next {
    margin-top: 88px;
    padding-top: 80px;
    border-top: 1px solid var(--line);
  }
  .head {
    max-width: 640px;
  }
  .tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 18px;
    margin: 36px 0;
  }
  .tab {
    padding: 9px 18px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    color: var(--muted);
    cursor: pointer;
    transition: 0.15s ease;
    background: transparent;
    border: 1px solid transparent;
    font-family: inherit;
  }
  .tab:hover {
    color: var(--ink);
    background: var(--soft);
  }
  .tab.is-active {
    background: var(--ink);
    color: #fff;
  }
  .tab:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .panel {
    display: none;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 48px;
    align-items: center;
  }
  .panel.is-active {
    display: grid;
  }
  @media (max-width: 900px) {
    .panel.is-active {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .panel-text h3 {
    font-size: clamp(22px, 2.4vw, 28px);
    letter-spacing: -0.02em;
    font-weight: 800;
    margin-bottom: 14px;
  }
  .panel-text > p {
    color: var(--muted);
    font-size: 17px;
    margin-bottom: 22px;
  }
  .checks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }
  .checks li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 15px;
  }
  .tick {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 800;
    margin-top: 1px;
  }

  /* Görsel / video paneli */
  .frame {
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow-lg);
  }
  .frame-bar {
    display: flex;
    gap: 7px;
    padding: 13px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-soft);
  }
  .frame-bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .frame-body {
    aspect-ratio: 16 / 10;
    background: #0a0a0a;
  }
  .frame-body img,
  .frame-body video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #8a8a8a;
    text-align: center;
    padding: 24px;
    background: repeating-linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.02) 0,
      rgba(255, 255, 255, 0.02) 10px,
      transparent 10px,
      transparent 20px
    );
  }
  .placeholder b {
    color: #e6e6e6;
    font-size: 15px;
  }
  .placeholder span {
    font-size: 13px;
  }
</style>

<script>
  // Sekme geçişi (JS iyileştirmesi; JS yoksa ilk panel görünür kalır).
  document.querySelectorAll<HTMLElement>("#ozellikler .showcase").forEach((sc) => {
    const tabs = [...sc.querySelectorAll<HTMLButtonElement>(".tab")];
    const panels = [...sc.querySelectorAll<HTMLElement>(".panel")];
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => {
          t.classList.remove("is-active");
          t.setAttribute("aria-selected", "false");
        });
        panels.forEach((p) => p.classList.remove("is-active"));
        tab.classList.add("is-active");
        tab.setAttribute("aria-selected", "true");
        panels[i]?.classList.add("is-active");
      });
    });
  });
</script>
