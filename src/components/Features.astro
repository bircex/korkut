---
// Yetenekler — iki grup (Hukuk / Ofis), her biri attacklens.io "Discover and
// assess" tarzı sekmeli showcase. Sekmelerin sağ paneline ss/video gelecek:
//   shot: "/shots/arastirma.png"  → görsel
//   video: "/shots/dilekce.mp4"   → video
// İkisi de boşsa yer tutucu (placeholder) gösterilir.
const groups = [
  {
    key: "hukuk",
    eyebrow: "Hukuk yetenekleri",
    title: "Davanın hukuki tarafı",
    lead: "İçtihattan dilekçeye, belge incelemesine — hukuki işin ağır yükünü Korkut taşır, siz onaylarsınız.",
    tabs: [
      {
        id: "arastirma",
        tab: "Araştırma",
        title: "İçtihat & mevzuat araştırması",
        body: "Yargıtay, Danıştay, UYAP Emsal, Anayasa Mahkemesi ve mevzuatta canlı arama yapar; emsalleri özetler ve daima kaynak gösterir.",
        points: [
          "11+ resmî ve yarı-resmî kaynakta tek arayüzden arama",
          "Sonuçları özetler, uydurma atıfları önlemek için kaynağa bağlar",
          "Resmî Gazete tarih/sayı ve tam metin filtresi",
        ],
        shot: "/shots/arastirma.png",
        video: null,
      },
      {
        id: "dilekce",
        tab: "Dilekçe",
        title: "Dilekçe & sözleşme taslağı",
        body: "Canvas editöründe dava türüne uygun dilekçe ve sözleşme taslakları üretir; birlikte düzenler, DOCX/UDF olarak dışa aktarır.",
        points: [
          "Şablon kataloğundan belge türünü algılar",
          "Canvas'ta canlı, madde madde düzenleme",
          "DOCX ve UYAP (UDF) formatında dışa aktarım",
        ],
        shot: "/shots/dilekce.png",
        video: null,
      },
      {
        id: "belge",
        tab: "Belge inceleme",
        title: "Belge inceleme & çıkarım",
        body: "Yüklenen evrağın metnini yerelde, güvenle çıkarır. Dosya diske yazılmaz; içerik 'güvenilmez veri' olarak izole edilir.",
        points: [
          "Yerelde metin çıkarımı — bayt içeriği diske yazılmaz",
          "Katı dosya doğrulama (magic-number) ve boyut sınırı",
          "Prompt injection'a karşı içerik izolasyonu",
        ],
        shot: null,
        video: null,
      },
    ],
  },
  {
    key: "ofis",
    eyebrow: "Ofis yetenekleri",
    title: "Büronun günlük işleyişi",
    lead: "Dosya, takvim, görev, bütçe ve yazışma — büronun idari tarafı da aynı asistanda, aynı onay akışında.",
    tabs: [
      {
        id: "dosya",
        tab: "Dosyalar",
        title: "Dosya yönetimi",
        body: "Dosya no, mahkeme, dava türü ve karşı tarafı tek panelde tutar; durum güncellemeleri ve notlarla izler. Yaklaşan duruşmaları dosya listesinin başında gösterir.",
        points: [
          "Dosya oluştur, güncelle, listele",
          "Mahkeme, esas no ve karşı taraf tek yerde",
          "Onaysız hiçbir kayıt oluşturulmaz",
        ],
        shot: "/shots/dosya.png",
        video: null,
      },
      {
        id: "muvekkil",
        tab: "Müvekkiller",
        title: "Müvekkil yönetimi",
        body: "Müvekkilin kişisel ve iletişim bilgilerini tek kartta tutar; buluta giden metinlerde bu bilgiler otomatik maskelenir (rumuzlanır).",
        points: [
          "Ad, T.C. kimlik no, telefon, e-posta ve adres tek kartta",
          "Müvekkili dosyalarla ilişkilendirme",
          "Buluta giden metinde otomatik maskeleme",
        ],
        shot: "/shots/muvekkil.png",
        video: null,
      },
      {
        id: "takvim",
        tab: "Takvim",
        title: "Duruşma takvimi & etkinlikler",
        body: "Duruşmaları ekler ve listeler; tekrarlayan etkinlikleri (rrule) destekler, yaklaşan işleri önden gösterir.",
        points: [
          "Duruşma ekle/listele — tarih, saat, yer, tür",
          "Tekrarlayan etkinlikler (rrule) desteği",
          "Yaklaşan 14/365 günlük gündem görünümü",
        ],
        shot: "/shots/takvim.png",
        video: null,
      },
      {
        id: "gorev",
        tab: "Görev & süre",
        title: "Süre takibi & görev gündemi",
        body: "Usul sürelerini ve görevleri takip eder; proaktif gündemle neyin yaklaştığını hatırlatır, tamamlananları işaretler.",
        points: [
          "Süre/görev ekle, tamamla, listele",
          "Proaktif gündem: yaklaşan süre & duruşmalar",
          "Kaçırılan süre riskini önden uyarır",
        ],
        shot: "/shots/gorev.png",
        video: null,
      },
      {
        id: "butce",
        tab: "Bütçe & cari",
        title: "Fatura, masraf & cari takibi",
        body: "Fatura ve masrafları kaydeder; müvekkil bazında cari hesabı — faturalanan, tahsil edilen, kalan bakiye — özetler.",
        points: [
          "Fatura & masraf kaydı",
          "Cari hesap: faturalanan / tahsilat / bakiye",
          "Dosya, mali ve görev verisinden raporlama",
        ],
        shot: "/shots/butce.png",
        video: null,
      },
      {
        id: "yazisma",
        tab: "Yazışma",
        title: "Kanallar arası yazışma",
        body: "Telegram, WhatsApp ve e-posta üzerinden iki yönlü iletişim; öner-ve-onayla ile hiçbir mesaj siz onaylamadan gitmez.",
        points: [
          "Telegram, WhatsApp ve e-posta (SMTP/IMAP)",
          "Öner-ve-onayla: giden mesaj önce önünüze gelir",
          "Yanıtlar doğrudan ilgili dosyayla ilişkilenir",
        ],
        shot: null,
        video: null,
      },
    ],
  },
  {
    key: "ozellestir",
    eyebrow: "Özelleştirme",
    title: "Büronuza göre uyarlayın",
