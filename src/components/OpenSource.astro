---
import { GITHUB_URL, DOCS_URL } from "../consts";

const points = [
  {
    title: "MIT lisansı",
    body: "Kodun tamamı açık. İnceleyin, değiştirin, kendi büronuza göre uyarlayın.",
  },
  {
    title: "Self-hosted",
    body: "Tek komutla kendi sunucunuza kurun. SaaS yok, abonelik yok, kilitlenme yok.",
  },
  {
    title: "Telemetri yok",
    body: "Proje hiçbir kullanım verisi toplamaz. Geliştiriciler kurulumunuza erişemez.",
  },
  {
    title: "Topluluk katkısı",
    body: "Yeni araçlar ve kaynaklar eklemek kolay. Issue açın, PR gönderin, tartışmaya katılın.",
  },
];
---

<section id="acik-kaynak">
  <div class="wrap">
    <div class="os-card">
      <div class="os-head">
        <span class="eyebrow" style="color:#a3a3a3">Açık kaynak</span>
        <h2>Şeffaf, denetlenebilir ve sizin</h2>
        <p>
          Korkut, MIT lisanslı açık kaynak bir projedir. Müvekkil verisiyle
          çalışan bir yazılımın nasıl davrandığını görebilmeniz gerekir — o yüzden
          her satır GitHub'da.
        </p>
        <div class="os-cta">
          <a href={GITHUB_URL} target="_blank" rel="noopener" class="btn btn-white">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
            GitHub'da yıldız verin
          </a>
          <a href={DOCS_URL} target="_blank" rel="noopener" class="btn btn-outline">
            Dokümantasyon
          </a>
        </div>
      </div>

      <ul class="os-points">
        {
          points.map((p) => (
            <li>
              <b>{p.title}</b>
              <span>{p.body}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .os-card {
    background: linear-gradient(160deg, #0a0a0a, #1f1f1f);
    border-radius: 28px;
    padding: 56px;
    color: #fff;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  @media (max-width: 900px) {
    .os-card {
      grid-template-columns: 1fr;
      gap: 36px;
      padding: 40px 28px;
    }
  }
  .os-head h2 {
    color: #fff;
    margin-top: 10px;
  }
  .os-head p {
    color: #c7c7c7;
    font-size: 17px;
    max-width: 460px;
  }
  .os-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .btn-white {
    background: #fff;
    color: #0f141b;
  }
  .btn-white:hover {
    background: #eef1f4;
    transform: translateY(-1px);
  }
  .btn-outline {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.28);
  }
  .btn-outline:hover {
    border-color: rgba(255, 255, 255, 0.6);
  }
  .os-points {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 28px;
  }
  @media (max-width: 480px) {
    .os-points {
      grid-template-columns: 1fr;
    }
  }
  .os-points li {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 16px;
  }
  .os-points b {
    display: block;
    font-size: 16px;
    margin-bottom: 6px;
  }
  .os-points span {
    color: #a3a3a3;
    font-size: 14.5px;
  }
</style>
