<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\shared\Korkut.Infrastructure\Korkut.Infrastructure.csproj" />
    <ProjectReference Include="..\..\services\Korkut.Web\Korkut.Web.csproj" />
    <!-- The assistant (model -> brain -> chat/drafting, its tools and its own DB) and the RAG
         index run in this host too: one process serves the whole app. -->
    <ProjectReference Include="..\..\modules\Korkut.Agent.Model\Korkut.Agent.Model.csproj" />
    <ProjectReference Include="..\..\modules\Korkut.Agent.Brain\Korkut.Agent.Brain.csproj" />
    <ProjectReference Include="..\..\modules\Korkut.Agent.Chat\Korkut.Agent.Chat.csproj" />
    <ProjectReference Include="..\..\modules\Korkut.Agent.Drafting\Korkut.Agent.Drafting.csproj" />
    <ProjectReference Include="..\..\modules\Korkut.Agent.Ledger\Korkut.Agent.Ledger.csproj" />
    <ProjectReference Include="..\..\modules\Korkut.Tools\Korkut.Tools.csproj" />
    <ProjectReference Include="..\..\modules\Korkut.Knowledge\Korkut.Knowledge.csproj" />
    <ProjectReference Include="..\..\shared\Korkut.Ai\Korkut.Ai.csproj" />
    <ProjectReference Include="..\..\shared\Korkut.Agent.Persistence\Korkut.Agent.Persistence.csproj" />
  </ItemGroup>
  <!-- Ship the static legal template catalog with the app so TemplateCatalog resolves
       it at {BaseDirectory}/templates in published/containerized runs (KORKUT_TEMPLATES_DIR overrides). -->
  <ItemGroup>
    <Content Include="..\..\..\templates\**\*" LinkBase="templates" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <ProjectReference Include="..\..\shared\Korkut.Security\Korkut.Security.csproj" />
  </ItemGroup>
</Project>
