<Project Sdk="Microsoft.NET.Sdk">
  <!-- SavedDecisions module ("Kararlarım"): the office's bookmarked public-database decisions.
       One tenant-owned table over the shared KorkutDbContext — same Clean Architecture layout as
       Finance (Entities/Repositories/Services/Extensions/Controllers). References only
       kernel/contract/persistence/web-kernel. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup>
    <!-- The module's internals (repository, service impl) are hidden from other modules but
         visible to this module's own isolated unit-test project. -->
    <InternalsVisibleTo Include="Korkut.SavedDecisions.Unit.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\shared\Korkut.Core\Korkut.Core.csproj" />
    <ProjectReference Include="..\..\shared\Korkut.Contract\Korkut.Contract.csproj" />
    <ProjectReference Include="..\..\shared\Korkut.Persistence\Korkut.Persistence.csproj" />
  </ItemGroup>
</Project>
