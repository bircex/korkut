    <ProjectReference Include="..\Korkut.Agent.Model\Korkut.Agent.Model.csproj" />
    <ProjectReference Include="..\Korkut.Tools\Korkut.Tools.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Korkut.Agent.Brain.Unit.Tests" />
    <InternalsVisibleTo Include="Korkut.Infrastructure.Tests" />
  </ItemGroup>
</Project>
