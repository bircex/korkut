<Project Sdk="Microsoft.NET.Sdk">
  <!-- Matters module (dosyalar): the matter aggregate plus its Party child (litigants; a supporting
       entity with no independent surface, so Party→Matter is an intra-module FK). The Matter→Client
       FK is a cross-module DB constraint configured in Infrastructure. Cross-module reads go through
       Contract lookups (ICourtLookup for the court-name snapshot, IHearingLookup for the detail's
       hearings). References only kernel/contract/persistence/web-kernel. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\shared\Korkut.Core\Korkut.Core.csproj" />
    <ProjectReference Include="..\..\shared\Korkut.Contract\Korkut.Contract.csproj" />
    <ProjectReference Include="..\..\shared\Korkut.Persistence\Korkut.Persistence.csproj" />
    <ProjectReference Include="..\..\shared\Korkut.Web.Kernel\Korkut.Web.Kernel.csproj" />
  </ItemGroup>
</Project>
