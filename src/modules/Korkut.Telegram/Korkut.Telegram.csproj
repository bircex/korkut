       kernel/contract/persistence plus the permission resolver. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Korkut.Telegram.Unit.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\shared\Korkut.Core\Korkut.Core.csproj" />
    <ProjectReference Include="..\..\shared\Korkut.Contract\Korkut.Contract.csproj" />
    <ProjectReference Include="..\..\shared\Korkut.Persistence\Korkut.Persistence.csproj" />
    <ProjectReference Include="..\..\shared\Korkut.Security\Korkut.Security.csproj" />
  </ItemGroup>
</Project>
