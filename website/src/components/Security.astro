---
const base = import.meta.env.BASE_URL;
const items = [
  {
    title: "Veriler kendi makinenizde",
    body: "Korkut büronuzun bilgisayarına veya sunucusuna kurulur. Dosyalar, müvekkiller, belgeler ve sohbetler kendi veritabanınızda durur; proje ekibinin erişimi yoktur.",
  },
  {
    title: "Yerel model, sıfır dışarı akış",
    body: "LM Studio veya Ollama gibi yerel bir modelle çalıştırın; hiçbir metin makinenizden çıkmaz. Bulut modeli seçerseniz giden metin önce en iyi çaba ile rumuzlanır.",
  },
  {
    title: "Dosya bazlı yetkilendirme",
    body: "Hazır ve özel roller, izin bazlı yetkiler. Herkes yalnızca ekibinde olduğu dosyaları görür; kural veritabanında da (satır düzeyi güvenlik) uygulanır.",
  },
  {
    title: "Hassas bilgiye ayrı izin",
    body: "Müvekkil iletişim ve kimlik bilgileri ile mali kayıtlar ayrı izinlere bağlıdır; izni olmayana maskelenmiş görünür.",
  },
  {
    title: "Erişim kayıtları",
    body: "Müvekkil bilgisi ve mali kayıt görüntülemeleri, rol ve ekip değişiklikleri, reddedilen erişimler kayıt altındadır.",
  },
  {
    title: "Onaysız kalıcı işlem yok",
    body: "Siz onaylamadan hiçbir kayıt oluşturulmaz, hiçbir mesaj gönderilmez. Kod açık olduğu için her şeyi kendiniz denetleyebilirsiniz.",
  },
];
---

<section id="guvenlik" class="band">
  <div class="wrap center">
    <span class="eyebrow">Gizlilik &amp; Güvenlik</span>
    <h2>Veriler kontrolünüzde kalır</h2>
    <p class="section-lead">
      Müvekkil verisi en hassas varlığınızdır. Korkut'u kendiniz kurar ve
      işletirsiniz; veri de, kontrol de, KVKK sorumluluğu da büronuzda kalır.
    </p>
  </div>

  <div class="wrap sec-grid">
    {
      items.map((i) => (
        <div class="sec-card">
          <span class="tick" aria-hidden="true">✓</span>
          <b>{i.title}</b>
          <span class="body">{i.body}</span>
        </div>
      ))
    }
  </div>

  <div class="wrap center foot-row">
    <p class="disclaimer">
      Korkut hukuki tavsiye vermez; her çıktı, nitelikli bir avukatın gözden
      geçirmesi gereken bir taslaktır. Ayrıntılar{" "}
      <a href={`${base}kosullar/`}>Lisans ve sorumluluk</a> sayfasında yer alır.
    </p>
    <a class="more" href={`${base}guvenlik/`}>Ayrıntılı güvenlik sayfası →</a>
  </div>
</section>

<style>
  .sec-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 44px;
  }
  @media (max-width: 900px) {
    .sec-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .sec-grid {
      grid-template-columns: 1fr;
    }
  }
  .sec-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 22px 20px;
  }
  .sec-card .tick {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 800;
    margin-bottom: 14px;
  }
  .sec-card b {
    display: block;
    font-size: 16px;
    letter-spacing: -0.012em;
    margin-bottom: 6px;
  }
  .sec-card .body {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.6;
  }
  .foot-row {
    margin-top: 36px;
  }
  .disclaimer {
    font-size: 13.5px;
    color: var(--muted);
    max-width: 560px;
    margin: 0 auto 16px;
  }
  .disclaimer a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .more {
    font-weight: 600;
    font-size: 15px;
  }
  .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
