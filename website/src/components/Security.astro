---
const base = import.meta.env.BASE_URL;
const items = [
  {
    title: "Her büro tamamen izole",
    body: "Her büro veritabanı düzeyinde satır düzeyi güvenlik ile ayrılır. Hiçbir büro bir diğerinin verisini göremez.",
  },
  {
    title: "Buluta giderken rumuzlama",
    body: "Modele giden metinde isim, T.C. kimlik no ve dosya no gibi bilgiler önce en iyi çaba ile rumuzlanır.",
  },
  {
    title: "Onaysız kalıcı işlem yok",
    body: "Siz onaylamadan hiçbir kayıt oluşturulmaz, hiçbir mesaj gönderilmez. Her giden mesaj önce önünüze gelir.",
  },
  {
    title: "Güçlü kimlik doğrulama",
    body: "Google ile giriş veya e-posta ve parola; yönetim panelinde zorunlu iki adımlı doğrulama (TOTP).",
  },
  {
    title: "Şifreli hassas alanlar",
    body: "Müvekkil kimlik bilgileri gibi hassas alanlar veritabanında ayrıca şifrelenir.",
  },
  {
    title: "Her model çağrısı kayıtlı",
    body: "Yapay zekaya yapılan her çağrı büro bazında kayıt altındadır; sistem tek bir denetlenen giriş noktasının arkasında çalışır.",
  },
];
---

<section id="guvenlik" class="band">
  <div class="wrap center">
    <span class="eyebrow">Gizlilik &amp; Güvenlik</span>
    <h2>Veriler kontrolünüzde kalır</h2>
    <p class="section-lead">
      Müvekkil verisi en hassas varlığınızdır. Korkut baştan sona bu ilkeyle
      tasarlandı; KVKK sorumluluğu sizde, kontrol de sizde kalır.
    </p>
  </div>

  <div class="wrap sec-grid">
    {
      items.map((i) => (
        <div class="sec-card">
          <span class="tick" aria-hidden="true">✓</span>
          <b>{i.title}</b>
          <span class="body">{i.body}</span>
        </div>
      ))
    }
  </div>

  <div class="wrap center foot-row">
    <p class="disclaimer">
      Korkut hukuki tavsiye vermez; her çıktı, nitelikli bir avukatın gözden
      geçirmesi gereken bir taslaktır. Ayrıntılar
      <a href={`${base}kosullar/`}>Kullanım Koşulları</a>'nda yer alır.
    </p>
    <a class="more" href={`${base}guvenlik/`}>Ayrıntılı güvenlik sayfası →</a>
  </div>
</section>

<style>
  .sec-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 44px;
  }
  @media (max-width: 900px) {
    .sec-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .sec-grid {
      grid-template-columns: 1fr;
    }
  }
  .sec-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 22px 20px;
  }
  .sec-card .tick {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 800;
    margin-bottom: 14px;
  }
  .sec-card b {
    display: block;
    font-size: 16px;
    letter-spacing: -0.012em;
    margin-bottom: 6px;
  }
  .sec-card .body {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.6;
  }
  .foot-row {
    margin-top: 36px;
  }
  .disclaimer {
    font-size: 13.5px;
    color: var(--muted);
    max-width: 560px;
    margin: 0 auto 16px;
  }
  .disclaimer a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .more {
    font-weight: 600;
    font-size: 15px;
  }
  .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
