---
import { docHref } from "../docs";
// Yetenekler: dört grup (Hukuk / Ofis / Özelleştirme). Her alt yetenek kendi
// bloğunda, medya bir sağda bir solda akacak şekilde (zigzag) listelenir:
//   shot: "/shots/arastirma.png"  → görsel
//   video: "/shots/dilekce.mp4"   → video
// İkisi de boşsa yer tutucu (placeholder) gösterilir.
type Tab = {
  id: string;
  tab: string;
  title: string;
  body: string;
  points: string[];
  shot?: string | null;
  video?: string | null;
  // Bu yeteneğin dokümantasyon sayfası (src/docs.ts içindeki slug).
  doc: string;
};
type Group = { key: string; eyebrow: string; title: string; lead: string; tabs: Tab[] };

const groups: Group[] = [
  {
    key: "hukuk",
    eyebrow: "Hukuk yetenekleri",
    title: "Davanın hukuki tarafı",
    lead: "İçtihattan dilekçeye, belge incelemesine kadar hukuki işin ağır yükünü Korkut taşır, siz onaylarsınız.",
    tabs: [
      {
        id: "sohbet",
        doc: "sohbet",
        tab: "Sohbet",
        title: "Dosyanın içinde sohbet",
        body: "Sohbetler dosyaların altında durur. Bir dosyanın sohbetinde Korkut yalnızca o dosyanın kayıtları ve belgeleriyle çalışır; ekip aynı sohbeti birlikte yürütür. Dosyasız işler için kişisel sohbet de vardır.",
        points: [
          "Dosya klasörleri altında sohbetler, ekiple ortak",
          "Dosya sohbetinde asistan yalnızca o dosyaya erişir",
          "Hangi aracı neyle çağırdığı sohbette görünür",
        ],
        shot: "/shots/sohbet.png",
        video: null,
      },
      {
        id: "arastirma",
        doc: "arastirma",
        tab: "Araştırma",
        title: "İçtihat & mevzuat araştırması",
        body: "Yargıtay, Danıştay, UYAP Emsal, Anayasa Mahkemesi ve mevzuatta canlı arama yapar; emsalleri özetler ve daima kaynak gösterir.",
        points: [
          "11+ resmî ve yarı-resmî kaynakta tek arayüzden arama",
          "Sonuçları özetler, uydurma atıfları önlemek için kaynağa bağlar",
          "Resmî Gazete tarih/sayı ve tam metin filtresi",
        ],
        shot: "/shots/arastirma.png",
        video: null,
      },
      {
        id: "dilekce",
        doc: "dilekce-ve-sozlesme",
        tab: "Dilekçe",
        title: "Dilekçe yazımı",
        body: "Dava, cevap ve beyan dilekçelerini sohbetten üretir; yan yana açılan editörde birlikte düzenlersiniz. Mahkeme başlık düzeni ve talep sonucu kalıpları hazır gelir.",
        points: [
          "Şablon kataloğundan dilekçe türünü algılar",
          "İçtihat atıflarını esas ve karar numarasıyla ekler",
          "DOCX ve UYAP (UDF) formatında dışa aktarım",
        ],
        shot: "/shots/dilekce.png",
        video: null,
      },
      {
        id: "sozlesme",
        doc: "dilekce-ve-sozlesme",
        tab: "Sözleşme",
        title: "Sözleşme taslağı",
        body: "Hizmet, lisans ve kira dahil sözleşmeleri madde madde kurar; SLA, bedel, gizlilik ve fesih hükümlerini işinize göre uyarlar, riskli hükümlerde sizi uyarır.",
        points: [
          "Madde bazlı kurgu: kapsam, SLA, bedel, gizlilik, fesih",
          "Geçerlilik riski taşıyan hükümlerde uyarı",
          "Pazarlık turları sürüm geçmişiyle saklanır",
        ],
        shot: "/shots/sozlesme.png",
        video: null,
      },
      {
        id: "belgeler",
        doc: "belgeler",
        tab: "Belgeler",
        title: "Belge kütüphanesi",
        body: "Üretilen her taslak tek kütüphanede durur: sözleşmeler ve dilekçeler ayrı gruplanır, her belge bağlandığı sohbet ve dosyayla birlikte açılır.",
        points: [
          "Sözleşme / dilekçe ayrımıyla düzenli arşiv",
          "Her belgede sürüm geçmişi ve değişiklik notu",
          "Belgeden ilgili sohbete tek tıkla dönüş",
        ],
        shot: "/shots/belgeler.png",
        video: null,
      },
    ],
  },
  {
    key: "ofis",
    eyebrow: "Ofis yetenekleri",
    title: "Büronun günlük işleyişi",
    lead: "Dosya, takvim, görev ve bütçe dahil, büronun idari tarafı da aynı asistanda ve aynı onay akışında.",
    tabs: [
      {
        id: "dosya",
        doc: "dosyalar",
        tab: "Dosyalar",
        title: "Dosya yönetimi",
        body: "Dosya no, mahkeme, dava türü ve karşı tarafı tek panelde tutar. Her dosyanın bir ekibi vardır; sohbetler, belgeler, ajanda ve notlar dosyanın altında toplanır ve yalnızca ekip görür.",
        points: [
          "Sohbetler, belgeler ve ajanda dosya altında",
          "Dosya ekibi: herkes yalnızca kendi dosyalarını görür",
          "Onaysız hiçbir kayıt oluşturulmaz",
        ],
        shot: "/shots/dosya-detay.png",
        video: null,
      },
      {
        id: "ekip",
        doc: "dosyalar",
        tab: "Dosya ekibi",
        title: "Her dosyanın kendi ekibi",
        body: "Dosyayı yalnızca ekibindekiler görür. Sorumlu avukat ekibi kendisi yönetir; ekipten çıkan biri dosyaya artık erişemez. Kural veritabanında da uygulanır.",
        points: [
          "Ekibe ekle, sorumlu yap, çıkar",
          "Ekipte olmayana dosya hiç görünmez",
          "Takvim, görev, belge ve sohbet aynı kurala uyar",
        ],
        shot: "/shots/ekip.png",
        video: null,
      },
      {
        id: "muvekkil",
        doc: "muvekkiller",
        tab: "Müvekkiller",
        title: "Müvekkil yönetimi",
        body: "Müvekkilin kişisel ve iletişim bilgilerini tek kartta tutar. İletişim ve kimlik bilgilerini yalnızca izni olan görür; bulut modeli kullanırsanız giden metinde bu bilgiler maskelenir.",
        points: [
          "Ad, T.C. kimlik no, telefon, e-posta ve adres tek kartta",
          "İletişim ve kimlik bilgisi ayrı izne bağlı",
          "Bulut modelinde otomatik maskeleme",
        ],
        shot: "/shots/muvekkil.png",
        video: null,
      },
      {
        id: "takvim",
        doc: "ajanda",
        tab: "Takvim",
        title: "Duruşma takvimi & etkinlikler",
        body: "Duruşmaları ekler ve listeler; tekrarlayan etkinlikleri (rrule) destekler, yaklaşan işleri önden gösterir.",
        points: [
          "Duruşma ekle/listele (tarih, saat, yer, tür)",
          "Tekrarlayan etkinlikler (rrule) desteği",
          "Yaklaşan 14/365 günlük gündem görünümü",
        ],
        shot: "/shots/takvim.png",
        video: null,
      },
      {
        id: "gorev",
        doc: "ajanda",
        tab: "Görev & süre",
        title: "Süre takibi & görev gündemi",
        body: "Usul sürelerini ve görevleri takip eder; proaktif gündemle neyin yaklaştığını hatırlatır, tamamlananları işaretler.",
        points: [
          "Süre/görev ekle, tamamla, listele",
          "Proaktif gündem: yaklaşan süre & duruşmalar",
          "Kaçırılan süre riskini önden uyarır",
        ],
        shot: "/shots/gorev.png",
        video: null,
      },
      {
        id: "butce",
        doc: "mali",
        tab: "Bütçe & cari",
        title: "Fatura, masraf & cari takibi",
        body: "Fatura ve masrafları kaydeder; müvekkil bazında cari hesabı (faturalanan, tahsil edilen, kalan bakiye) özetler.",
        points: [
          "Fatura & masraf kaydı",
          "Cari hesap: faturalanan / tahsilat / bakiye",
          "Dosya, mali ve görev verisinden raporlama",
        ],
        shot: "/shots/butce.png",
        video: null,
      },
    ],
  },
  {
    key: "guvenlik",
    eyebrow: "Ekip ve güvenlik",
    title: "Kim neyi görür, siz belirleyin",
    lead: "Rol ve dosya bazlı yetkiler, erişim kayıtları, büronun kendi Telegram botu ve dilediğiniz yapay zeka modeli; hepsi kendi makinenizde.",
    tabs: [
      {
        id: "roller",
        doc: "roller-ve-yetkiler",
        tab: "Roller",
        title: "Roller ve yetkiler",
        body: "Avukat, stajyer, sekreter, muhasebe ve okuyucu gibi hazır roller; büroya özel roller de tanımlayabilirsiniz. Her izin tek tek açılıp kapanır, değişiklik hemen geçerli olur.",
        points: [
          "29 izin, hazır ve özel roller",
          "Müvekkil iletişim ve kimlik bilgisi ayrı izinle",
          "Mali kayıtlar yalnızca yetkiliye",
        ],
        shot: "/shots/roller.png",
        video: null,
      },
      {
        id: "erisim",
        doc: "erisim-kayitlari",
        tab: "Erişim kayıtları",
        title: "Erişim kayıtları",
        body: "Kim hangi müvekkilin bilgisine ya da mali kayıtlara baktı, kim kimi ekibe ekledi, kim yetkisi olmayan bir şeyi denedi; hepsi kayıt altında.",
        points: [
          "Müvekkil bilgisi ve mali kayıt görüntülemeleri",
          "Rol ve ekip değişiklikleri, reddedilen erişimler",
          "Kayda değer değil, alan adı yazılır",
        ],
        shot: "/shots/erisim.png",
        video: null,
      },
      {
        id: "telegram",
        doc: "telegram",
        tab: "Telegram",
        title: "Telegram'dan Korkut",
        body: "Büronun kendi botuyla özelden yazışın, dosyalar arasında geçin, hatırlatmaları alın. Bir grubu dosyaya bağlayın; gruptaki herkes dosyanın ekibindeyse bot cevap verir, değilse içerik paylaşmaz.",
        points: [
          "/dosya, /dosyalar ve /kisisel komutları",
          "Dosyaya bağlı gruplar, üyelik denetimi",
          "Gruplarda müvekkil bilgisi hiç paylaşılmaz",
        ],
        shot: "/shots/telegram.png",
        video: null,
      },
      {
        id: "yapay-zeka",
        doc: "yapay-zeka",
        tab: "Yapay zeka",
        title: "Modelinizi siz seçin",
        body: "LM Studio veya Ollama ile yerel bir model bağlayın, hiçbir metin makinenizden çıkmasın. Ya da OpenAI, Anthropic veya Gemini gibi bir bulut modeli seçin; giden metin önce rumuzlanır.",
        points: [
          "Yerel, OpenAI uyumlu modeller",
          "Bulut modelinde rumuzlama",
          "Kullanım ve maliyet görünümü",
        ],
        shot: "/shots/yapay-zeka.png",
        video: null,
      },
    ],
  },
  {
    key: "ozellestir",
    eyebrow: "Özelleştirme",
    title: "Büronuza göre uyarlayın",
    lead: "Korkut'un üslubunu, hafızasını ve belge stilini büronuzun çalışma biçimine göre ayarlayın; çekirdek güvenlik, atıf ve onay kuralları sabit kalır.",
    tabs: [
      {
        id: "kisilik",
        doc: "kisisellestirme",
        tab: "Kişilik",
        title: "Asistan kişiliği",
        body: "Korkut'un ses tonunu, uzmanlık alanlarını ve büro kurallarını belirleyin. Çekirdek güvenlik/atıf/onay kuralları koddadır; buradan yalnızca üzerine eklersiniz.",
        points: [
          "Üslup ve ses tonu ayarı",
          "Büronun uzmanlık alanları",
          "Çekirdek güvenlik ve onay kuralları değiştirilemez",
        ],
        shot: "/shots/kisilik.png",
        video: null,
      },
      {
        id: "hafiza",
        doc: "kisisellestirme",
        tab: "Hafıza",
        title: "Kalıcı hafıza",
        body: "Büronun kalıcı tercihlerini ve notlarını her sohbette hatırlar. Korkut'un önerdiği notlar siz onaylayana kadar beklemede kalır; hiçbir şey izinsiz hatırlanmaz.",
        points: [
          "Büro geneli kalıcı notlar ve tercihler",
          "Öner-ve-onayla: onaysız bilgi hatırlanmaz",
          "Bulut modelinde maskelenir",
        ],
        shot: "/shots/hafiza.png",
        video: null,
      },
      {
        id: "stil",
        doc: "kisisellestirme",
        tab: "Stil",
        title: "Antet, imza & belge stili",
        body: "Dilekçe ve sözleşmelerin antetini, imza bloğunu ve üslubunu tek yerden yönetin. Antet ve imza modele gönderilmez; belgeye aynen eklenir.",
        points: [
          "Büro anteti ve imza bloğu",
          "Standart kalıplar (kapanış, vekâlet ücreti…)",
          "Antet ve imza modele gönderilmez",
        ],
        shot: "/shots/stil.png",
        video: null,
      },
    ],
  },
];
const base = import.meta.env.BASE_URL; // "/korkut/" alt yolunda, apex'te "/"
---

<section id="ozellikler">
  <div class="wrap">
    {
      groups.map((g, gi) => (
        <div class={`showcase ${gi > 0 ? "showcase-next" : ""}`}>
          <div class="head">
            <span class="eyebrow">{g.eyebrow}</span>
            <h2>{g.title}</h2>
            <p class="section-lead">{g.lead}</p>
          </div>

          <div class="rows">
            {g.tabs.map((t, i) => (
              <div
                class={`row ${i % 2 === 1 ? "row-flip" : ""}`}
                id={`${g.key}-${t.id}`}
              >
                <div class="row-text">
                  <h3>{t.title}</h3>
                  <p>{t.body}</p>
                  <ul class="checks">
                    {t.points.map((p) => (
                      <li>
                        <span class="tick" aria-hidden="true">✓</span>
                        <span>{p}</span>
                      </li>
                    ))}
                  </ul>
                  <a class="doc-link" href={docHref(base, t.doc)}>Dokümantasyonu oku →</a>
                </div>

                <div class="row-media">
                  <div class="frame">
                    <div class="frame-bar" aria-hidden="true">
                      <span /> <span /> <span />
                    </div>
                    <div class="frame-body">
                      {t.video ? (
                        <video src={`${base}${t.video.slice(1)}`} muted autoplay loop playsinline preload="metadata" />
                      ) : t.shot ? (
                        <img src={`${base}${t.shot.slice(1)}`} alt={`${t.title} ekran görüntüsü`} loading="lazy" />
                      ) : (
                        <div class="placeholder">
                          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="14" rx="2" />
                            <path d="M3 15l4-4 3 3 4-5 7 6" />
                            <circle cx="8.5" cy="8.5" r="1.4" />
                          </svg>
                          <b>Ekran görüntüsü / video</b>
                          <span>Bu yeteneğin gösterimi buraya gelecek</span>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<!-- Tam ekran görüntü (lightbox). Ekran görüntüsüne tıklayınca büyür. -->
<div class="lightbox" id="lightbox" hidden>
  <button class="lightbox-close" type="button" aria-label="Kapat">×</button>
  <img class="lightbox-img" src="" alt="" />
</div>

<style>
  .doc-link {
    display: inline-block;
    margin-top: 14px;
    font-weight: 600;
    font-size: 14.5px;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  #ozellikler {
    padding-bottom: 96px;
  }
  .showcase-next {
    margin-top: 88px;
    padding-top: 80px;
    border-top: 1px solid var(--line);
  }
  .head {
    max-width: 640px;
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: 76px;
    margin-top: 44px;
  }
  .row {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 48px;
    align-items: center;
  }
  /* Zigzag: her ikinci blokta medya sola, metin sağa geçer. */
  .row-flip {
    grid-template-columns: 1.15fr 0.85fr;
  }
  .row-flip .row-media {
    order: -1;
  }
  @media (max-width: 900px) {
    .row,
    .row-flip {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    /* Dar ekranda sıra her zaman metin, sonra medya. */
    .row-flip .row-media {
      order: 0;
    }
  }

  .row-text h3 {
    font-size: clamp(22px, 2.4vw, 28px);
    letter-spacing: -0.02em;
    font-weight: 800;
    margin-bottom: 14px;
  }
  .row-text > p {
    color: var(--muted);
    font-size: 17px;
    margin-bottom: 22px;
  }
  .checks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }
  .checks li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 15px;
  }
  .tick {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 800;
    margin-top: 1px;
  }

  /* Görsel / video paneli */
  .frame {
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow-lg);
  }
  .frame-bar {
    display: flex;
    gap: 7px;
    padding: 13px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-soft);
  }
  .frame-bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .frame-body {
    aspect-ratio: 16 / 10;
    background: #0a0a0a;
  }
  .frame-body img,
  .frame-body video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Ekran görüntüsü tıklanınca büyür. */
  .frame-body img {
    cursor: zoom-in;
  }
  .placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #8a8a8a;
    text-align: center;
    padding: 24px;
    background: repeating-linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.02) 0,
      rgba(255, 255, 255, 0.02) 10px,
      transparent 10px,
      transparent 20px
    );
  }
  .placeholder b {
    color: #e6e6e6;
    font-size: 15px;
  }
  .placeholder span {
    font-size: 13px;
  }

  /* Tam ekran görüntü (lightbox) */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vmin;
    background: rgba(10, 10, 10, 0.86);
    backdrop-filter: blur(4px);
    cursor: zoom-out;
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox.open {
    opacity: 1;
  }
  .lightbox-img {
    max-width: 92vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    cursor: default;
  }
  .lightbox-close {
    position: absolute;
    top: 18px;
    right: 22px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.15s ease;
  }
  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.24);
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      transition: none;
    }
  }
</style>

<script>
  // Ekran görüntüsüne tıklayınca tam ekran gösterim (lightbox).
  const lb = document.getElementById("lightbox") as HTMLElement | null;
  const lbImg = lb?.querySelector<HTMLImageElement>(".lightbox-img");
  const lbClose = lb?.querySelector<HTMLButtonElement>(".lightbox-close");
  let lastFocus: HTMLElement | null = null;

  const openLightbox = (src: string, alt: string) => {
    if (!lb || !lbImg) return;
    lastFocus = document.activeElement as HTMLElement;
    lbImg.src = src;
    lbImg.alt = alt;
    lb.hidden = false;
    // Görünürlüğe geçmeden bir kare bekleyip geçiş animasyonunu tetikle.
    requestAnimationFrame(() => lb.classList.add("open"));
    document.body.style.overflow = "hidden";
    lbClose?.focus();
  };

  const closeLightbox = () => {
    if (!lb || !lbImg) return;
    lb.classList.remove("open");
    document.body.style.overflow = "";
    const done = () => {
      lb.hidden = true;
      lbImg.src = "";
      lb.removeEventListener("transitionend", done);
    };
    lb.addEventListener("transitionend", done);
    // Animasyon çalışmazsa yine de kapat.
    setTimeout(done, 220);
    lastFocus?.focus();
  };

  document
    .querySelectorAll<HTMLImageElement>("#ozellikler .frame-body img")
    .forEach((img) => {
      img.setAttribute("role", "button");
      img.setAttribute("tabindex", "0");
      img.setAttribute("aria-label", `${img.alt} (büyütmek için tıklayın)`);
      img.addEventListener("click", () => openLightbox(img.currentSrc || img.src, img.alt));
      img.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openLightbox(img.currentSrc || img.src, img.alt);
        }
      });
    });

  // Görselin dışına tıklama, kapat düğmesi ve Esc ile kapanır.
  lb?.addEventListener("click", (e) => {
    if (e.target === lb) closeLightbox();
  });
  lbClose?.addEventListener("click", closeLightbox);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && lb && !lb.hidden) closeLightbox();
  });
</script>
