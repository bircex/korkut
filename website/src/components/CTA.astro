---
import { REPO_URL, CONTRIBUTING_URL, ISSUES_URL } from "../consts";
import GitHubIcon from "./GitHubIcon.astro";
---

<section id="katki">
  <div class="wrap">
    <div class="cta">
      <h2>Birlikte geliştirelim</h2>
      <p>
        Korkut açık kaynak ve topluluğa açık. Hata bildirin, özellik önerin,
        kod gönderin ya da büronuzda deneyip deneyiminizi paylaşın.
      </p>
      <div class="cta-row">
        <a href={REPO_URL} rel="noopener" class="btn btn-primary btn-lg gh">
          <GitHubIcon size={18} />
          GitHub'da yıldızla
        </a>
        <a href={CONTRIBUTING_URL} rel="noopener" class="btn btn-ghost btn-lg">Katkı rehberi</a>
        <a href={ISSUES_URL} rel="noopener" class="btn btn-ghost btn-lg">Hata bildir</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    background: linear-gradient(135deg, #0a0a0a, #1f1f1f);
    border-radius: 24px;
    padding: 64px 40px;
    text-align: center;
    color: #fff;
  }
  .cta h2 {
    color: #fff;
  }
  .cta p {
    color: #c7c7c7;
    font-size: 18px;
    max-width: 560px;
    margin: 0 auto 32px;
  }
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .cta-row {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta .btn-primary {
    background: #fff;
    color: var(--ink);
  }
  .cta .btn-primary:hover {
    background: #e5e5e5;
  }
  .cta .btn-ghost {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
  }
  .cta .btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background: transparent;
  }
</style>
