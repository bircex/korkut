---
// Dokümantasyon sayfalarının ortak düzeni: solda gruplu menü, sağda içerik. Markdown sayfaları bu
// düzeni frontmatter'daki `layout` ile kullanır; sayfa `slug` alanıyla src/docs.ts'teki kaydını bulur.
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { DOCS, DOC_GROUPS, docHref } from "../docs";
import { REPO_URL } from "../consts";

const { frontmatter } = Astro.props as { frontmatter: { slug: string } };
const base = import.meta.env.BASE_URL;
const index = DOCS.findIndex((d) => d.slug === frontmatter.slug);
const doc = DOCS[index];
if (!doc) throw new Error(`docs.ts içinde "${frontmatter.slug}" yok`);
const prev = DOCS[index - 1];
const next = DOCS[index + 1];
const editUrl = `${REPO_URL}/edit/main/website/src/pages/dokumantasyon/${doc.slug}.md`;
---

<Layout title={`${doc.title} · Korkut dokümantasyonu`} description={doc.description} path={docHref(base, doc.slug)}>
  <Nav />
  <main id="icerik" class="docs">
    <div class="wrap docs-grid">
      <nav class="docs-nav" aria-label="Dokümantasyon">
        <a class="docs-home" href={`${base}dokumantasyon/`}>Dokümantasyon</a>
        {
          DOC_GROUPS.map((g) => (
            <div class="docs-group">
              <b>{g}</b>
              {DOCS.filter((d) => d.group === g).map((d) => (
                <a href={docHref(base, d.slug)} aria-current={d.slug === doc.slug ? "page" : undefined}>
                  {d.title}
                </a>
              ))}
            </div>
          ))
        }
      </nav>

      <article class="docs-body">
        <p class="crumb">{doc.group}</p>
        <h1>{doc.title}</h1>
        <p class="lead">{doc.description}</p>
        {
          doc.shot && (
            <figure class="shot">
              <img src={`${base}${doc.shot.slice(1)}`} alt={`${doc.title} ekran görüntüsü`} width="1440" height="900" loading="eager" />
            </figure>
          )
        }
        <div class="prose">
          <slot />
        </div>

        <nav class="pager" aria-label="Sayfalar arası geçiş">
          {prev ? <a class="prev" href={docHref(base, prev.slug)}><span>Önceki</span>{prev.title}</a> : <span />}
          {next ? <a class="next" href={docHref(base, next.slug)}><span>Sonraki</span>{next.title}</a> : <span />}
        </nav>
        <p class="edit"><a href={editUrl} rel="noopener">Bu sayfayı GitHub'da düzenleyin</a></p>
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .docs {
    padding: 40px 0 80px;
  }
  .docs-grid {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }
  .docs-nav {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 14px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }
  .docs-home {
    font-weight: 700;
    color: var(--ink);
  }
  .docs-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .docs-group b {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .docs-group a {
    color: var(--muted);
    padding: 3px 0 3px 10px;
    border-left: 2px solid transparent;
  }
  .docs-group a:hover {
    color: var(--ink);
  }
  .docs-group a[aria-current="page"] {
    color: var(--ink);
    font-weight: 600;
    border-left-color: var(--ink);
  }
  .docs-body {
    min-width: 0;
    max-width: 820px;
  }
  .crumb {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    margin: 0 0 6px;
  }
  .docs-body h1 {
    font-size: clamp(30px, 4vw, 40px);
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .lead {
    font-size: 17px;
    color: var(--muted);
    margin: 0 0 24px;
  }
  .shot {
    margin: 0 0 32px;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 48px;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--ink);
    font-weight: 600;
  }
  .pager a:hover {
    border-color: var(--line-strong);
  }
  .pager span {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--muted);
  }
  .pager .next {
    text-align: right;
  }
  .edit {
    margin-top: 20px;
    font-size: 13.5px;
  }
  .edit a {
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .docs-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .docs-nav {
      position: static;
      max-height: none;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px 18px;
    }
    .docs-group {
      display: none;
    }
  }
</style>
