---
import Layout from "../layouts/Layout.astro";
import { DEMO_PATH } from "../consts";

// Eski "Demo iste" ve "Ücretsiz Başla" bağlantıları kırılmasın: /demo artık ana sayfadaki
// kurulum bölümüne yönlendirir. Meta refresh CSP'ye takılmaz (inline script yok);
// görünen bağlantı yönlendirme çalışmazsa yedektir.
const base = import.meta.env.BASE_URL;
const target = `${base}#kurulum`;
---

<Layout
  title="Kurulum"
  description="Korkut açık kaynaktır; Docker ile kendi makinenize dakikalar içinde kurarsınız."
  path={`${base}${DEMO_PATH}`}
>
  <meta slot="head" http-equiv="refresh" content={`0;url=${target}`} />
  <main id="icerik">
    <section class="redirect">
      <div class="wrap">
        <h1>Kurulum</h1>
        <p>Korkut artık açık kaynak; sizi kurulum adımlarına yönlendiriyoruz…</p>
        <p><a class="btn btn-primary" href={target}>Kurulum adımlarına git</a></p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .redirect {
    display: grid;
    place-items: center;
    min-height: 60vh;
    text-align: center;
    padding: 48px 0;
  }
</style>
