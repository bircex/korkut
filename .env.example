# API contract for the .NET migration (KDM-030).
#   python  -> legacy Python endpoints (default; Google-only sign-in)
#   dotnet  -> .NET auth contract: local login + policy-driven TOTP, session refresh
# The Python branch is isolated to src/session.ts and is deleted once the cutover
# completes. Never put secrets/tokens here — this file is committed.
VITE_API_MODE=python
