# Korkut environment template — copy to .env and fill in the values.
# The real .env is gitignored (it holds secrets); this .example is committed.
# Multi-tenant SaaS runs on Postgres; bring the whole stack up from the repo root:
#   docker compose up -d --build   → UI http://localhost:8090, admin http://localhost:8092

# ================= Required =================

# Session + JWT signing key. MUST be stable across restarts (a new key logs everyone out).
#   python -c "import secrets; print(secrets.token_hex(32))"
KORKUT_SECRET=

# Google OIDC — the only sign-in. Create a "Web application" OAuth client in the Google Cloud
# Console (APIs & Services → Credentials), and register the redirect URI below on that client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8090/api/auth/google/callback

# AI model — pick ONE provider key (chat can't answer without one). When DEEPSEEK_API_KEY is
# set it becomes the cloud provider; otherwise Anthropic is used.
# DEEPSEEK_API_KEY=            # OpenAI-compatible; DEEPSEEK_MODEL defaults to deepseek-chat
ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# ================= Database (Postgres) =================
# With the root docker-compose.yml the admin + app DSNs are built for you and default to safe
# local values — for production just set strong passwords here:
# POSTGRES_PASSWORD=            # Postgres superuser (the one-shot bootstrap uses it)
# KORKUT_APP_DB_PASSWORD=       # the non-superuser korkut_app role the app connects as
#
# NOT using that compose (e.g. managed Postgres)? Set the DSNs explicitly instead:
# KORKUT_ADMIN_DB_URL=postgresql+psycopg://<admin>:<pw>@<host>:5432/korkut   # bootstrap only
# KORKUT_DB_URL=postgresql+psycopg://korkut_app:<pw>@<host>:5432/korkut      # app + workers
# KORKUT_APP_DB_ROLE=korkut_app

# ================= Production hardening =================
# KORKUT_SECURE_COOKIES=1   # behind TLS: cookies get the Secure flag
# KORKUT_TRUST_PROXY=1      # behind a reverse proxy: trust X-Forwarded-For for the real IP
# KORKUT_HOST=0.0.0.0
# KORKUT_PORT=8090

# ================= Admin console (korkut-admin, optional) =================
# The superadmin console (root docker-compose.yml `admin` service) shares this .env. The superadmin
# allowlist is HARD-CODED in korkut-admin (auth._SUPERADMINS), not an env var.
# KORKUT_ADMIN_REDIRECT_URI=https://admin-domain/admin/api/auth/google/callback   # add to the OAuth client

# ================= Outbound e-mail (SMTP) =================
# Korkut sends mail from ONE operator-controlled account (there is no per-office e-mail integration).
# Leave blank to disable the send_email tool. For Gmail use an App Password, not your login password.
# KORKUT_SMTP_FROM=            # sender address (falls back to KORKUT_SMTP_USER if unset)
# KORKUT_SMTP_USER=            # SMTP login username
# KORKUT_SMTP_PASSWORD=        # SMTP password / app password
# KORKUT_SMTP_FROM_NAME=Korkut # display name on the From header
# KORKUT_SMTP_HOST=smtp.gmail.com
# KORKUT_SMTP_PORT=587
#
# Onboarding notifications (need SMTP above). A new demo request e-mails the operator; approving
# an office from the admin console e-mails the owner "your account is ready" with the app URL.
# KORKUT_ADMIN_NOTIFY_EMAIL=you@example.com   # who gets demo-request alerts (comma-sep for several)
# KORKUT_APP_URL=http://localhost:8090        # tenant app URL put in the owner approval e-mail

# ================= Optional =================
# KORKUT_ALLOW_DEMO=0      # turn OFF self-serve demo requests (default on; a superadmin approves each)
# TAVILY_API_KEY=           # web search for the legal-search tools (KVKK / BDDK / tahkim)
# Model tuning (defaults are fine): ANTHROPIC_MODEL, GROQ_MODEL, OPENAI_MODEL, ANTHROPIC_MAX_TOKENS,
# KORKUT_CONTEXT_WINDOW, KORKUT_LOCAL_CONTEXT_WINDOW, KORKUT_REPLY_HEADROOM

# ================= .NET multi-host deploy (root docker-compose.yml) =================
# The .NET backend runs as separate hosts (gateway/api/agent/knowledge/ocr/worker) behind one
# Postgres cluster + PgBouncer, with OTLP telemetry to the Grafana LGTM stack. The compose builds
# the per-host DB DSNs for you from the two passwords below; you only set secrets/keys here.
# POSTGRES_PASSWORD=            # Postgres superuser (the one-shot migrator uses it, session mode)
# KORKUT_APP_DB_PASSWORD=       # non-superuser korkut_app role the runtime hosts connect as (via PgBouncer)
# KORKUT_TOTP_KEY=              # API 2FA envelope key, base64 of 32 bytes: openssl rand -base64 32
# Uploaded documents are kept on the `objects` volume. To use an S3-compatible server instead:
# KORKUT_STORAGE=s3
# KORKUT_MINIO_ENDPOINT=host:9000
# KORKUT_MINIO_ACCESS_KEY=
# KORKUT_MINIO_SECRET_KEY=
# KORKUT_MINIO_SECURE=1          # https
# Knowledge/RAG embeddings — prefer a LOCAL endpoint so office data never leaves the cluster:
# KORKUT_EMBEDDING_URL=         # e.g. http://ollama:11434/v1 (unset → search returns 503)
# KORKUT_EMBEDDING_MODEL=nomic-embed-text
# KORKUT_EMBEDDING_API_KEY=     # only for a hosted embedding endpoint
# OCR (scanned uploads). The compose wires these already; override only to tune or disable:
# KORKUT_OCR_ENGINE=tesseract   # on the ocr host; anything else leaves the 503 scaffold in place
# KORKUT_OCR_LANGS=tur+eng      # tesseract language data shipped in the image
# KORKUT_OCR_URL=http://ocr:8080  # on api/agent; UNSET means text-layer-only extraction (scans
#                                 # come back empty), so leave the compose default alone
# On-prem chat model (OpenAI-compatible; skips PII redaction since data stays in-office):
# KORKUT_OLLAMA_URL=
# Per-office model-usage governance (0 = unlimited):
# KORKUT_OFFICE_TOKEN_BUDGET=0  # monthly prompt+completion token cap per office
# KORKUT_OFFICE_CONCURRENCY=0   # max concurrent model calls per office (per replica)
