# Korkut environment template — copy to .env and fill in the values you need.
# `install.sh` / `install.ps1` do this automatically and generate KORKUT_SECRET for you.
#
# Local güvenlik notu: bu dosya .env.example'dır ve commit'lenir; gerçek .env DOSYASI
# ASLA commit edilmez (.gitignore içinde) çünkü sırlar (KORKUT_SECRET, API anahtarları) içerir.

# ---- Core ----
# Session-cookie signing key — stable 64-hex string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is used and regenerated on every restart (sessions won't survive restarts).
KORKUT_SECRET=

# Database URL. Leave unset/commented for the default local SQLite DB under ./data.
# KORKUT_DB_URL=postgresql+psycopg://korkut:<pw>@db:5432/korkut

# Bind address/port (defaults shown)
# KORKUT_HOST=0.0.0.0
# KORKUT_PORT=8080

# Production hardening (behind TLS / a reverse proxy)
# KORKUT_SECURE_COOKIES=1
# KORKUT_TRUST_PROXY=1

# Name for the first office (optional)
# KORKUT_DEFAULT_OFFICE=

# ---- Model provider (pick one cloud key, or leave both unset and configure a local
# OpenAI-compatible endpoint from Settings → Model after first login) ----
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Optional: web search for the search_kvkk / search_bddk / search_sigorta_tahkim tools ----
# TAVILY_API_KEY=

# ---- Optional: WhatsApp sidecar (deploy/docker-compose.yml --profile whatsapp) ----
# KORKUT_WA_TOKEN=
