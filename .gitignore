# Müvekkil verisi ve sırlar — ASLA commit edilmez (KVKK / avukatlık sırrı)
data/
*.env
.env
.env.*
!.env.example
secrets/

# Operator's real model catalog (KORKUT_MODELS_FILE) — config/models.example.json is the
# committed template; each environment keeps its own config/models.json.
config/models.json
*.key
*.pem

# The built SPA is committed under backend/src/korkut/api/static (produced in the korkut-ui
# repo, copied in via `make ui`). Intentionally NOT ignored so the image ships a ready UI.

# Runtime data (SQLite DB, generated coverage snapshots)
data/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Yedek / log
*.log
*.bak
backups/

# Branding assets (keep owned/licensed logos out of the repo)
branding/*.png
branding/*.jpg
branding/*.jpeg
branding/*.svg
branding/*.ico

# OS / editör
.DS_Store
.idea/
.vscode/
/.claude
.mcp.json

# .NET build artifacts (flattened to repo root — keep source-only)
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/
TestResults/
*.trx
*.nupkg
project.lock.json

# Local-only compose overrides (host port publishing etc. for native dotnet run / VS dev)
docker-compose.override.yml
