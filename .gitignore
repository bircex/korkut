# Müvekkil verisi ve sırlar — ASLA commit edilmez (KVKK / avukatlık sırrı)
data/
*.env
.env
.env.*
secrets/
*.key
*.pem

# Frontend build artifacts (the SPA is built from web/frontend/ into web/static/)
web/frontend/node_modules/
web/frontend/dist/
web/frontend/*.tsbuildinfo
web/static/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Yedek / log
*.log
*.bak
backups/

# Branding assets (keep owned/licensed logos out of the repo)
branding/*.png
branding/*.jpg
branding/*.jpeg
branding/*.svg
branding/*.ico

# OS / editör
.DS_Store
.idea/
.vscode/
